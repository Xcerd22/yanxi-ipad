        chapters.set(chapter.id, subject.id);
        if (chapters.size > LIMITS.chapters) error('ç« èŠ‚æ•°é‡è¶…è¿‡æœ¬æœºè¯»å–é™åˆ¶');
        for (const topic of chapter.topics) {
          if (!record(topic) || !validID(topic.id) || topics.has(topic.id) || (topic.subject && topic.subject !== subject.id) || (topic.chapterId && topic.chapterId !== chapter.id) || !title(topic.title) || !requiredText(topic.statement) || !stringArray(topic.pitfalls) || !stringArray(topic.questionPrompts)) error('çŸ¥è¯†ç‚¹è®°å½•æˆ–ç¼–å·æ— æ•ˆ');
