    catch (_) { throw new Error('èµ„æ–™åŒ…ç›®å½•å·²æŸåï¼Œè¯·é‡æ–°å¤åˆ¶å®Œæ•´çš„ .yanxi æ–‡ä»¶ã€‚'); }
    rejectUnsafeKeys(manifest);
    if (!manifest || typeof manifest !== 'object' || Array.isArray(manifest)) throw new Error('èµ„æ–™åŒ…ç›®å½•ç»“æ„ä¸æ­£ç¡®ã€‚');
    const data = manifest.appData;
    if (manifest.format !== 'yanxi-offline' || manifest.version !== 1 || !data || !Array.isArray(data.subjects) || !Array.isArray(data.sources) || !Array.isArray(data.questions) || !Array.isArray(manifest.searchPages) || !Array.isArray(manifest.files)) throw new Error('èµ„æ–™åŒ…ç‰ˆæœ¬æˆ–ç»“æ„ä¸å—æ”¯æŒï¼Œè¯·ä½¿ç”¨æœ¬è½¯ä»¶é…å¥—çš„èµ„æ–™åŒ…ã€‚');
    if (data.subjects.length !== 4 || data.subjects.some(s => !s || !SUBJECT_ORDER.includes(s.id) || !Array.isArray(s.chapters)) || new Set(data.subjects.map(s => s.id)).size !== 4 || !data.questions.length || data.questions.length > LIMITS.questions || !data.sources.length || data.sources.length > 200 || manifest.files.length !== data.sources.length) throw new Error('èµ„æ–™åŒ…ä¸­çš„è¯¾ç¨‹æˆ–é¢˜åº“ä¸å®Œæ•´ï¼Œæˆ–æ•°é‡è¶…è¿‡æœ¬æœºè¯»å–é™åˆ¶ã€‚');
    const sourceIndex = new Map();
    for (const source of data.sources) {
      if (!source || typeof source.id !== 'string' || source.id.length > 120 || !/^[a-z]+-[a-f0-9]+$/.test(source.id) || sourceIndex.has(source.id) || !SUBJECT_ORDER.includes(source.subject) || typeof source.title !== 'string' || !source.title.trim() || source.title.length > LIMITS.title || !validRelativePath(source.path) || !Number.isInteger(source.pages) || source.pages < 1 || source.pages > MAX_PDF_PAGES) throw new Error('èµ„æ–™åŒ…ä¸­å­˜åœ¨æ— æ•ˆã€è¶…å‡ºé™åˆ¶æˆ–é‡å¤çš„èµ„æ–™è®°å½•ã€‚');
      sourceIndex.set(source.id, source);
    }
    validateContent(data, sourceIndex);
    let offset = 0; const ids = new Set();
    for (const entry of manifest.files) {
      if (!entry || typeof entry !== 'object') throw new Error('èµ„æ–™åŒ…æ–‡ä»¶ç›®å½•ä¸å®Œæ•´ã€‚');
      const source = sourceIndex.get(entry.sourceId);
      if (!source || ids.has(entry.sourceId) || entry.path !== source.path || entry.sha256 !== source.sha256 || !/^[a-f0-9]{64}$/.test(entry.sha256) || !Number.isSafeInteger(entry.size) || entry.size !== source.bytes || entry.size < 5 || !Number.isSafeInteger(entry.offset) || entry.offset !== offset) throw new Error('èµ„æ–™åŒ…æ–‡ä»¶ç›®å½•æ ¡éªŒå¤±è´¥ï¼Œè¯·é‡æ–°å–å¾—å®Œæ•´èµ„æ–™åŒ…ã€‚');
      if (entry.size > MAX_PDF) throw new Error('èµ„æ–™åŒ…ä¸­çš„å•ä»½ PDF è¶…è¿‡ 128 MBï¼Œæ— æ³•åœ¨æœ¬æœºå®‰å…¨è¯»å–ã€‚');
