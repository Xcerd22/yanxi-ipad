        notify({phase:'copying', completed:index, total, bytes:copied, totalBytes:file.size - bodyOffset, message:`æ ¡éªŒå¹¶ä¿å­˜ ${index + 1} / ${total}ï¼š${manifest.appData.sources.find(s => s.id === entry.sourceId).title}`});
