/* ç ”ä¹  â€” self-contained, offline study workspace. No external requests. */
'use strict';
(() => {
  if (window.top && window.top !== window.self) return;
  if (document.querySelector('link[rel="manifest"]') && (!window.YanxiSecurity || !window.YanxiPlatform)) return;
  window.YanxiSecurity?.assertTopLevel();
  const STORAGE_KEY = 'yanxi.study.v1';
  const platform = window.YanxiPlatform;
  let ready = false;
  const SUBJECT_ORDER = ['nonlinear', 'convex', 'algebra', 'geometry'];
  const SUBJECT_STYLES = {
    algebra: {color:'#698156', tint:'#edf1e1', glyph:'G'},
    geometry: {color:'#8d7795', tint:'#f0eaf2', glyph:'âˆ‡'},
    convex: {color:'#b58d52', tint:'#f8f0df', glyph:'âˆ©'},
    nonlinear: {color:'#5c8894', tint:'#e9f1f0', glyph:'T'}
  };
  const ENGLISH = { 'ä»£æ•°å­¦': 'ALGEBRA', 'é»æ›¼å‡ ä½•': 'RIEMANNIAN GEOMETRY', 'å‡¸åˆ†æ': 'CONVEX ANALYSIS', 'éçº¿æ€§åˆ†æ': 'NONLINEAR ANALYSIS' };
  const LEVELS = ['æœªå¼€å§‹', 'å­¦ä¹ ä¸­', 'åŸºæœ¬ç†è§£', 'å·²æŒæ¡'];
  const $ = (s, node = document) => node.querySelector(s);
  const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const arr = value => Array.isArray(value) ? value : value ? [value] : [];
  const txt = value => typeof value === 'string' ? value : Array.isArray(value) ? value.map(txt).join('\n') : value == null ? '' : typeof value === 'object' ? Object.values(value).map(txt).join('ï¼›') : String(value);
  // The source corpus uses ** for mathematical biconjugates. Preserve every
  // character; applying Markdown emphasis here would change the mathematics.
  const rich = value => typesetMath(txt(value));
  const formatted = (record, field) => record[`${field}Formatted`] ?? record[field];
  const today = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
  const validDate = value => typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) && !Number.isNaN(new Date(`${value}T12:00:00`).getTime()) && new Date(`${value}T12:00:00`).toISOString().slice(0, 10) === value;
  const afterDays = days => { const d = new Date(); d.setDate(d.getDate() + days); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
  const freshProgress = () => ({ version: 1, topicProgress: {}, notes: {}, bookmarks: [], wrong: [], examDate: '', dailyMinutes: 60, reviewLog: {}, lastBackup: '' });
  let data = { subjects: [], sources: [], questions: [] }, subjects = new Map(), chapters = new Map(), topics = new Map(), sources = new Map(), questions = new Map();
  let progress = freshProgress(), storageAvailable = true, route = {}, searchToken = 0, toastTimer, reviewQueue = [], reviewIndex = 0, reviewRevealed = false, reviewSessionCount = 0, modalSource = null, modalPage = 1, modalPreviousFocus = null;

  function sanitizeProgress(raw) {
    if (!raw || typeof raw !== 'object' || Array.isArray(raw) || raw.version !== 1) throw new Error('è¿™ä¸æ˜¯ç ”ä¹ ç‰ˆæœ¬ 1 çš„å­¦ä¹ å¤‡ä»½æ–‡ä»¶ã€‚');
    const next = freshProgress();
    if (raw.examDate && !validDate(raw.examDate)) throw new Error('å¤‡ä»½ä¸­çš„è€ƒè¯•æ—¥æœŸæ ¼å¼ä¸æ­£ç¡®ã€‚');
    next.examDate = raw.examDate || '';
    next.dailyMinutes = Number.isFinite(Number(raw.dailyMinutes)) ? Math.max(10, Math.min(600, Math.round(Number(raw.dailyMinutes)))) : 60;
    for (const type of ['bookmarks', 'wrong']) {
      if (raw[type] != null && !Array.isArray(raw[type])) throw new Error('å¤‡ä»½ä¸­çš„æ”¶è—æˆ–é”™é¢˜åˆ—è¡¨æ ¼å¼ä¸æ­£ç¡®ã€‚');
      next[type] = [...new Set(arr(raw[type]).filter(x => typeof x === 'string' && x.length <= 200))].slice(0, 50000);
    }
    if (raw.notes && (typeof raw.notes !== 'object' || Array.isArray(raw.notes))) throw new Error('ç¬”è®°æ•°æ®æ ¼å¼ä¸æ­£ç¡®ã€‚');
    for (const [key, value] of Object.entries(raw.notes || {})) if (typeof value === 'string' && key.length <= 210 && !['__proto__', 'prototype', 'constructor'].includes(key)) next.notes[key] = value.slice(0, 100000);
    for (const [key, value] of Object.entries(raw.topicProgress || {})) {
      if (!value || typeof value !== 'object' || !Number.isInteger(value.level) || value.level < 0 || value.level > 3 || ['__proto__', 'prototype', 'constructor'].includes(key)) continue;
      next.topicProgress[key] = { level: value.level, due: validDate(value.due) ? value.due : today(), lastReviewed: validDate(value.lastReviewed) ? value.lastReviewed : '', reviewCount: Math.max(0, Math.min(100000, Number(value.reviewCount) || 0)) };
    }
    for (const [key, value] of Object.entries(raw.reviewLog || {})) if (validDate(key) && Number.isFinite(value) && value >= 0) next.reviewLog[key] = Math.min(value, 100000);
    next.lastBackup = typeof raw.lastBackup === 'string' ? raw.lastBackup.slice(0, 50) : '';
    return next;
  }
  function readProgress() {
    try { const raw = localStorage.getItem(STORAGE_KEY); if (raw) progress = sanitizeProgress(JSON.parse(raw)); } catch (e) { storageAvailable = false; console.warn('Local progress could not be read:', e.message); }
  }
  function save() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(progress)); storageAvailable = true; return true; }
    catch (e) { storageAvailable = false; toast('æµè§ˆå™¨æœªèƒ½ä¿å­˜è¿›åº¦ï¼Œè¯·ç«‹å³åˆ°è®¾ç½®ä¸­å¯¼å‡ºå¤‡ä»½ã€‚'); return false; }
  }
  function toast(message) { const el = $('#toast'); el.textContent = message; el.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('show'), 3500); }
  function hash(params) { return '#' + new URLSearchParams(Object.entries(params).filter(([,v]) => v !== undefined && v !== null && v !== '')).toString(); }
  function go(params) { const next = hash(params); if (location.hash === next) render(); else location.hash = next; }
  function currentRoute() { return Object.fromEntries(new URLSearchParams(location.hash.slice(1))); }
  function subjectName(id) { return subjects.get(id)?.name || 'æœªåˆ†ç±»'; }
  function orderCourses() {
    const rank = id => { const n=SUBJECT_ORDER.indexOf(id);return n<0?SUBJECT_ORDER.length:n; };
    data.subjects.sort((a,b)=>rank(a.id)-rank(b.id));
    for (const collection of [data.questions,data.sources]) collection.sort((a,b)=>rank(a.subject)-rank(b.subject));
  }
  function chapterHasQuestions(chapter) {
    return data.questions.some(q=>q.subject===chapter.subject &&
      (arr(q.chapterIds).includes(chapter.id) || arr(q.topicIds).some(id=>topics.get(id)?.chapterId===chapter.id)));
  }
  function chapterStar(chapter) {
    return chapterHasQuestions(chapter) ? '' : '<span class="chapter-uncovered" title="å½“å‰é¢˜åº“æš‚æ— å…³è”é¢˜ç›®" aria-label="å½“å‰é¢˜åº“æš‚æ— å…³è”é¢˜ç›®">ï¼Š</span>';
  }
  function subjectTopics(id) { return [...topics.values()].filter(t => !id || t.subject === id); }
  function masteredCount(id) { return subjectTopics(id).filter(t => (progress.topicProgress[t.id]?.level || 0) === 3).length; }
  function learnedCount(id) { return subjectTopics(id).filter(t => (progress.topicProgress[t.id]?.level || 0) > 0).length; }
  function dueTopics(id) { return subjectTopics(id).filter(t => { const p = progress.topicProgress[t.id]; return p && p.level > 0 && p.due && p.due <= today(); }); }
  function percent(id) { const total = subjectTopics(id).length; return total ? Math.round(masteredCount(id) / total * 100) : 0; }
  function sourceFor(id) { return sources.get(id); }
  function isPrimarySource(s) { return typeof s.primary === 'boolean' ? s.primary : /è¿‘ä¸–ä»£æ•°.*ä¸˜ç»´å£°|ä»£æ•°å­¦å¼•è®º.*ä¸çŸ³å­™|Riemannian Geometry.*Manfredo|^LectureSlide$|éçº¿æ€§æ³›å‡½åˆ†æå¼•è®º.*é’Ÿæ‰¿å¥/i.test(s.title || ''); }
  function daysRemaining() { return progress.examDate ? Math.ceil((new Date(`${progress.examDate}T00:00:00`) - new Date(`${today()}T00:00:00`)) / 86400000) : null; }
  function subjStyle(subject) { return `--subject-color:${esc(subject._color)};--subject-tint:${esc(subject._tint)}`; }
  function noteBox(key, label = 'æˆ‘çš„ç¬”è®°') { return `<details class="notes-details" ${progress.notes[key] ? 'open' : ''}><summary>${esc(label)}${progress.notes[key] ? ' Â· å·²è®°å½•' : ''}</summary><textarea class="note-input" data-note="${esc(key)}" placeholder="å†™ä¸‹è‡ªå·±çš„ç†è§£ã€è¯æ˜ä¸­å¡ä½çš„æ­¥éª¤ï¼Œæˆ–è¿˜éœ€è¦æŸ¥è¯çš„é—®é¢˜â€¦" aria-label="${esc(label)}" maxlength="100000">${esc(progress.notes[key] || '')}</textarea><p class="notes-hint">è¾“å…¥åè‡ªåŠ¨ä¿å­˜åœ¨å½“å‰æµè§ˆå™¨ã€‚æ¢ç”µè„‘æˆ–æ¢æµè§ˆå™¨å‰ï¼Œè¯·å¯¼å‡ºå­¦ä¹ å¤‡ä»½ã€‚</p></details>`; }
  function sourceButton(sourceId, page, label = 'æŸ¥çœ‹åŸæ–‡') { return sourceFor(sourceId) ? `<button class="text-link" data-action="source" data-source="${esc(sourceId)}" data-page="${Number(page) || 1}">${esc(label)} â†—</button>` : ''; }
  function fullPdfLink(source) { return platform ? '' : `<a href="/api/pdf/${encodeURIComponent(source.id)}#page=1" target="_blank" rel="noopener">æ‰“å¼€å®Œæ•´ PDF</a>`; }
  function empty(title, message, action = '') { return `<div class="empty-state"><div class="empty-icon" aria-hidden="true">âŒ‘</div><h3>${esc(title)}</h3><p>${esc(message)}</p>${action}</div>`; }
  function mainHeading(eyebrow, title, subtitle, actions = '') { return `<div class="page-heading"><div><div class="eyebrow">${esc(eyebrow)}</div><h1>${esc(title)}</h1><p>${esc(subtitle)}</p></div>${actions ? `<div class="heading-actions">${actions}</div>` : ''}</div>`; }

  function renderNav() {
    const links = [['dashboard', 'âŒ‚', 'å¤ä¹ æ€»è§ˆ'], ['exams', 'â–¤', 'å¾€å¹´é¢˜ä¸ç»ƒä¹ '], ['review', 'â†»', 'ä¸»åŠ¨å›å¿†'], ['library', 'â–¥', 'å‚è€ƒèµ„æ–™'], ['settings', 'âš™', 'è®¾ç½®ä¸å¤‡ä»½']];
    $('#main-nav').innerHTML = links.map(([id,icon,label]) => `<a class="nav-link ${route.view === id ? 'active' : ''}" href="${hash({view:id})}" ${route.view === id ? 'aria-current="page"' : ''}><span class="nav-icon" aria-hidden="true">${icon}</span>${label}${id === 'review' && dueTopics().length ? `<span class="nav-count">${dueTopics().length}</span>` : ''}</a>`).join('');
    $('#subject-nav').innerHTML = data.subjects.map(s => `<a class="nav-link subject-nav-link ${route.view === 'subject' && route.subject === s.id ? 'active' : ''}" href="${hash({view:'subject',subject:s.id})}" style="${subjStyle(s)}"><span class="subject-dot"></span>${esc(s.name)}</a>`).join('');
    const names = { dashboard:'å¤ä¹ æ€»è§ˆ', subject:subjectName(route.subject), exams:'å¾€å¹´é¢˜ä¸ç»ƒä¹ ', review:'ä¸»åŠ¨å›å¿†', library:'å‚è€ƒèµ„æ–™', search:'æœç´¢', settings:'è®¾ç½®ä¸å¤‡ä»½' };
    $('#breadcrumb').innerHTML = `<span>å­¦ä¹ ç©ºé—´</span> &nbsp;/&nbsp; ${esc(names[route.view] || 'å¤ä¹ æ€»è§ˆ')}`;
    const days = daysRemaining();
    $('#topbar-date').innerHTML = days === null ? 'è®¾ç½®è€ƒè¯•æ—¥æœŸ <span>â†—</span>' : days > 0 ? `è·è€ƒè¯• <strong>${days}</strong> å¤© <span>â†—</span>` : days === 0 ? 'ä»Šå¤©è€ƒè¯• Â· ä»å®¹åº”è€ƒ <span>â†—</span>' : 'æ›´æ–°è€ƒè¯•æ—¥æœŸ <span>â†—</span>';
    document.title = `${names[route.view] || 'å¤ä¹ æ€»è§ˆ'} Â· ç ”ä¹ `;
  }
  function dashboard() {
    const totalTopics = topics.size, totalChapters = chapters.size, due = dueTopics().length, days = daysRemaining();
    const lead = days === null ? 'è®©å¤ä¹ ï¼Œæœ‰è¿¹å¯å¾ªã€‚' : days > 0 ? 'æŠŠæ¯ä¸€å¤©ï¼Œå­¦å¾—æ›´æ‰å®ã€‚' : days === 0 ? 'ä»Šå¤©ï¼Œä»å®¹è½ç¬”ã€‚' : 'ç»§ç»­ç§¯ç´¯ï¼Œæ¸©æ•…çŸ¥æ–°ã€‚';
    const cards = data.subjects.map(s => {
      const ss = data.sources.filter(x => x.subject === s.id), count = subjectTopics(s.id).length;
      return `<a class="subject-card" href="${hash({view:'subject',subject:s.id})}" style="${subjStyle(s)}"><div class="subject-card-top"><div class="subject-glyph">${esc(s._glyph)}</div><div><h3>${esc(s.name)}</h3><div class="en-title">${esc(ENGLISH[s.name] || s.subtitle || 'CORE COURSE')}</div></div><span class="chevron">â†—</span></div><p class="subject-card-description">${esc(s.subtitle || ss.filter(x => isPrimarySource(x) && /æ•™æ|è¯¾ä»¶/.test(x.category)).map(x => x.title).slice(0,2).join(' Â· ') || 'ä»æ ¸å¿ƒå®šä¹‰åˆ°è¯æ˜æ–¹æ³•ï¼Œé€ç« å»ºç«‹çŸ¥è¯†ä½“ç³»ã€‚')}</p><div class="progress-line"><span>å·²æŒæ¡ ${masteredCount(s.id)} / ${count} ä¸ªçŸ¥è¯†ç‚¹</span><span>${percent(s.id)}%</span></div><div class="progress-track"><div class="progress-fill" style="width:${percent(s.id)}%"></div></div><div class="subject-meta"><span>${arr(s.chapters).length} ä¸ªç« èŠ‚</span><span>${data.questions.filter(q => q.subject === s.id).length} é“é¢˜ç›®</span><span>${ss.length} ä»½å‚è€ƒèµ„æ–™</span></div></a>`;
    }).join('');
    const previews = data.questions.slice(0,3).map(q => `<a class="question-preview" href="${hash({view:'exams',question:q.id,subject:q.subject})}"><span class="preview-icon">â–¤</span><div><h4>${esc(q.title)}</h4><p>${esc(subjectName(q.subject))} Â· ${esc(q.year || 'å¹´ä»½æœªæ³¨æ˜')} Â· ${arr(q.topicIds).length} ä¸ªå…³è”çŸ¥è¯†ç‚¹</p></div></a>`).join('');
    return mainHeading('YOUR LEARNING DESK','å¤§çœŸåŠ æ²¹ï¼Œä½ æ˜¯æœ€æ£’çš„ï¼','ç”¨æ•™æå»ºç«‹ä½“ç³»ï¼Œç”¨é¢˜ç›®æ£€éªŒç†è§£ã€‚æ¯ä¸€æ¬¡å›å¿†ï¼Œéƒ½ä¼šç•™ä¸‹ç§¯ç´¯ã€‚', `<a class="btn btn-light" href="${hash({view:'settings'})}">åˆ¶å®šå¤ä¹ è®¡åˆ’ <span>â†—</span></a>`) +
      `<section class="hero"><div><div class="eyebrow">FOCUS Â· UNDERSTAND Â· RECALL</div><h2>${lead}</h2><p>${due ? `ä»Šå¤©æœ‰ ${due} ä¸ªçŸ¥è¯†ç‚¹åˆ°äº†å¤ä¹ æ—¶é—´ã€‚ä»å›å¿†å¼€å§‹ï¼Œå†æŠŠè–„å¼±å¤„å¸¦å›æ•™æã€‚` : 'å…ˆç†è§£å®šä¹‰çš„æ¥ç”±ï¼Œå†æ¢³ç†å®šç†çš„æ¡ä»¶ï¼Œæœ€ååˆä¸Šä¹¦ï¼Œè¯•ç€ç‹¬ç«‹å®Œæˆè¯æ˜ã€‚'}</p><div class="hero-actions"><a class="btn btn-primary" href="${hash({view:'review'})}">å¼€å§‹ä»Šæ—¥å¤ä¹  <span>â†’</span></a><a class="btn btn-light" href="${hash({view:'exams'})}">ç»ƒä¸€é“é¢˜</a></div></div><div class="hero-aside"><div class="hero-number">${days === null ? data.subjects.length : Math.max(days,0)}<small>${days === null ? 'é—¨' : 'å¤©'}</small></div><p>${days === null ? 'æ ¸å¿ƒè¯¾ç¨‹ Â· æŒç»­ç§¯ç´¯' : days < 0 ? 'è€ƒè¯•æ—¥æœŸå·²è¿‡ï¼Œè¯·æ›´æ–°' : 'è·ç¦»è½¬åšè€ƒè¯•'}</p></div></section>` +
      `<div class="stats-grid"><div class="stat-card"><div class="stat-top">ç« èŠ‚æ¢³ç†<span class="stat-symbol">â–¥</span></div><div class="stat-value">${totalChapters}<small>ç« </small></div><div class="stat-note">æŒ‰æŒ‡å®šæ•™æä¸è¯¾ä»¶æ•´ç†</div></div><div class="stat-card"><div class="stat-top">çŸ¥è¯†æŒæ¡<span class="stat-symbol">â—‡</span></div><div class="stat-value">${masteredCount()}<small>/ ${totalTopics}</small></div><div class="stat-note">${learnedCount()} ä¸ªçŸ¥è¯†ç‚¹å·²å¼€å§‹å­¦ä¹ </div></div><div class="stat-card"><div class="stat-top">ä»Šæ—¥å¾…å¤ä¹ <span class="stat-symbol">â†»</span></div><div class="stat-value">${due}<small>ä¸ª</small></div><div class="stat-note">${progress.reviewLog[today()] || 0} æ¬¡å›å¿†ç»ƒä¹ å·²å®Œæˆ</div></div><div class="stat-card"><div class="stat-top">æˆ‘çš„é”™é¢˜<span class="stat-symbol">â–¤</span></div><div class="stat-value">${progress.wrong.filter(id => questions.has(id)).length}<small>é“</small></div><div class="stat-note">å›åˆ°çŸ¥è¯†ç‚¹ï¼Œæ‰¾å‡†å¡ä½çš„åœ°æ–¹</div></div></div>` +
      `<div class="dashboard-columns dashboard-single"><div><div class="section-heading"><h2>æˆ‘çš„è¯¾ç¨‹ <small>ä»ä½“ç³»ï¼Œåˆ°ç»†èŠ‚</small></h2><a class="text-link" href="${hash({view:'library'})}">å…¨éƒ¨èµ„æ–™ â†—</a></div><div class="subject-grid">${cards}</div>${previews ? `<section class="recent-section"><div class="section-heading"><h2>ä»ä¸€é“é¢˜å¼€å§‹</h2><a class="text-link" href="${hash({view:'exams'})}">é¢˜ç›®ç´¢å¼• â†’</a></div>${previews}</section>` : ''}</div></div>`;
  }

  function topicCard(t, i) {
    const level = progress.topicProgress[t.id]?.level || 0, saved = progress.bookmarks.includes(`topic:${t.id}`);
    const linked = data.questions.filter(q => arr(q.topicIds).includes(t.id));
    return `<article class="topic-card ${route.topic === t.id ? 'highlight' : ''}" id="topic-${esc(t.id)}"><div class="topic-topline"><div class="topic-title"><span class="topic-number">${String(i+1).padStart(2,'0')}</span><h3>${esc(t.title)}</h3></div><div class="topic-actions"><button class="icon-button ${saved?'active':''}" data-action="bookmark" data-id="topic:${esc(t.id)}" aria-label="${saved?'å–æ¶ˆæ”¶è—':'æ”¶è—çŸ¥è¯†ç‚¹'}" title="${saved?'å–æ¶ˆæ”¶è—':'æ”¶è—çŸ¥è¯†ç‚¹'}">${saved?'â˜…':'â˜†'}</button><button class="icon-button" data-action="share" data-hash="${esc(hash({view:'subject',subject:t.subject,chapter:t.chapterId,topic:t.id}))}" aria-label="å¤åˆ¶çŸ¥è¯†ç‚¹ä½ç½®" title="å¤åˆ¶çŸ¥è¯†ç‚¹ä½ç½®">â†—</button></div></div><div class="topic-statement">${rich(formatted(t,'statement'))}</div>${t.proofIdea ? `<div class="topic-label">è¯æ˜æ€è·¯ Â· éœ€è¦è‡ªå·±è¡¥è¶³ç»†èŠ‚</div><div class="proof-block">${rich(formatted(t,'proofIdea'))}</div>` : ''}${arr(t.pitfalls).length ? `<div class="pitfall-block"><strong>å®¹æ˜“å¿½ç•¥çš„åœ°æ–¹</strong><ul>${arr(formatted(t,'pitfalls')).map(p=>`<li>${rich(p)}</li>`).join('')}</ul></div>` : ''}${arr(t.questionPrompts).length ? `<div class="prompt-block"><div class="topic-label">åˆä¸Šä¹¦ï¼Œé—®é—®è‡ªå·±</div><ul>${arr(formatted(t,'questionPrompts')).map(p=>`<li>${rich(p)}</li>`).join('')}</ul></div>` : ''}<div class="source-line">${sourceButton(t.sourceId,t.sourcePage,'å¯¹ç…§åŸæ–‡')}${t.sourcePage ? `<span>PDF ç¬¬ ${Number(t.sourcePage)} é¡µ${t.sourceVerified === false ? ' Â· å®šä½å¾…å¤æ ¸' : ''}</span>` : ''}${linked.length ? `<a class="text-link" href="${hash({view:'exams',topic:t.id,subject:t.subject})}">å…³è” ${linked.length} é“é¢˜ç›® â†’</a>` : ''}</div>${t.sourceNote ? `<div class="source-warning">${rich(formatted(t,'sourceNote'))}</div>` : ''}<div class="mastery-row"><span>æˆ‘çš„ç†è§£ç¨‹åº¦</span>${LEVELS.map((label,n)=>`<button class="mastery-button ${level===n?'active':''}" data-action="mastery" data-id="${esc(t.id)}" data-level="${n}" aria-pressed="${level===n}">${label}</button>`).join('')}</div>${noteBox(`topic:${t.id}`)}</article>`;
  }
  function subjectView() {
    let s = subjects.get(route.subject) || data.subjects[0];
    if (!s) return empty('å°šæœªè½½å…¥è¯¾ç¨‹','è¯·æ£€æŸ¥æœ¬åœ°èµ„æ–™ç´¢å¼•æ˜¯å¦å·²ç”Ÿæˆã€‚');
    route.subject = s.id;
    let chapter = chapters.get(route.chapter);
    if (route.topic && topics.has(route.topic)) chapter = chapters.get(topics.get(route.topic).chapterId);
    if (!chapter || chapter.subject !== s.id) chapter = arr(s.chapters)[0];
    const index = arr(s.chapters).map((c,i) => `<a class="chapter-link ${chapter?.id===c.id?'active':''}" href="${hash({view:'subject',subject:s.id,chapter:c.id})}"><span class="chapter-number">${String(i+1).padStart(2,'0')}</span><span>${esc(c.title)}${chapterStar(c)}<small>${arr(c.topics).length} ä¸ªçŸ¥è¯†ç‚¹${c.pageStart ? ` Â· PDF ${c.pageStart}${c.pageEnd && c.pageEnd!==c.pageStart ? `â€“${c.pageEnd}`:''} é¡µ`:''}</small></span></a>`).join('');
    const source = chapter && sourceFor(chapter.sourceId);
    return mainHeading('COURSE NOTEBOOK',s.name,s.subtitle || 'ç”±æ ¸å¿ƒèµ„æ–™å±•å¼€ï¼Œé€ç« å»ºç«‹è‡ªå·±çš„ç†è§£ã€‚',`<a class="btn btn-light" href="${hash({view:'exams',subject:s.id})}">å…³è”é¢˜ç›® â†’</a>`) +
      `<div class="subject-banner" style="${subjStyle(s)}"><div class="subject-glyph">${esc(s._glyph)}</div><div><h2>ç†è§£æ¦‚å¿µï¼Œä¹Ÿç†è§£æ¡ä»¶</h2><p>${arr(s.chapters).length} ä¸ªç« èŠ‚ Â· ${subjectTopics(s.id).length} ä¸ªçŸ¥è¯†ç‚¹ Â· ${data.sources.filter(x=>x.subject===s.id).length} ä»½åŸå§‹èµ„æ–™</p></div><div class="subject-stats"><strong>${percent(s.id)}<small style="display:inline"> %</small></strong><small>çŸ¥è¯†ç‚¹æŒæ¡è¿›åº¦</small></div></div><div class="info-banner">è¿™äº›æ¢³ç†æ˜¯å¤ä¹ æçº²ä¸è¯æ˜çº¿ç´¢ã€‚ä¸¥æ ¼è¡¨è¿°ã€å‡è®¾æ¡ä»¶åŠå®Œæ•´è®ºè¯è¯·å¯¹ç…§åŸæ–‡ï¼›æ¥æºé¡µç å‡æŒ‰ PDF é¡µåºè®¡ç®—ã€‚${s.note ? ` ${esc(s.note)}`:''}</div><div class="subject-layout"><aside class="chapter-index"><div class="chapter-index-heading">ç« èŠ‚ç›®å½• <span class="count-pill">${arr(s.chapters).length}</span></div><p class="chapter-legend">ï¼Š å½“å‰é¢˜åº“æš‚æ— å…³è”é¢˜ç›®çš„ç« èŠ‚</p>${index}</aside><div class="chapter-main">${chapter ? `<section class="chapter-intro"><div class="eyebrow">CHAPTER ${String(arr(s.chapters).findIndex(c=>c.id===chapter.id)+1).padStart(2,'0')}</div><h2>${esc(chapter.title)}${chapterStar(chapter)}</h2><div class="chapter-summary">${rich(formatted(chapter,'summary'))}</div>${arr(chapter.prerequisites).length ? `<p style="margin-top:11px"><strong>å…ˆå¤‡çŸ¥è¯†ï¼š</strong>${rich(arr(chapter.prerequisites).map(x=>topics.get(x)?.title || chapters.get(x)?.title || x).join('ï¼›'))}</p>`:''}<div class="source-line">${source ? `<span>ä¸»è¦å‚è€ƒï¼š${esc(source.title)}</span>`:''}${sourceButton(chapter.sourceId,chapter.pageStart,'ä»æœ¬ç« åŸæ–‡å¼€å§‹')}${chapter.pageStart ? `<span>PDF ${chapter.pageStart}${chapter.pageEnd ? `â€“${chapter.pageEnd}`:''} é¡µ</span>`:''}</div>${chapter.note ? `<div class="source-warning">${rich(formatted(chapter,'note'))}</div>`:''}</section>${arr(chapter.topics).map(topicCard).join('')}`:empty('ç« èŠ‚æçº²å°šæœªç”Ÿæˆ','ç›®å‰å¯ä»¥å…ˆåœ¨å‚è€ƒèµ„æ–™ä¸­é˜…è¯»åŸå§‹æ•™æã€‚',`<a class="btn btn-primary" href="${hash({view:'library',subject:s.id})}">æ‰“å¼€å‚è€ƒèµ„æ–™</a>`)}</div></div>`;
  }

  function subjectFilters(view) { return `<button class="filter-chip ${!route.subject?'active':''}" data-action="filter" data-view="${view}" data-subject="">å…¨éƒ¨è¯¾ç¨‹</button>${data.subjects.map(s=>`<button class="filter-chip ${route.subject===s.id?'active':''}" data-action="filter" data-view="${view}" data-subject="${esc(s.id)}">${esc(s.name)}</button>`).join('')}`; }
  function typesetMath(value) {
    const renderParagraph = paragraph => {
      const pattern = /\\\[([\s\S]*?)\\\]|\\\(([\s\S]*?)\\\)/g;
      let out = '', cursor = 0, match, previousDisplay = false;
      while ((match = pattern.exec(paragraph))) {
        const display = match[1] !== undefined, tex = display ? match[1] : match[2];
        let prose = paragraph.slice(cursor, match.index);
        if (previousDisplay) prose = prose.trimStart();
        if (display) prose = prose.trimEnd();
        out += esc(prose).replace(/\n/g, '<br>');
        try {
          if (tex.length > 12000) throw new Error('å…¬å¼è¶…è¿‡æ’ç‰ˆé•¿åº¦é™åˆ¶');
          out += window.katex.renderToString(tex, {displayMode: display, throwOnError: true, strict: 'ignore', trust: false, maxSize:20, maxExpand:1000, output: 'htmlAndMathml'});
        } catch (error) {
          out += `<code class="math-fallback">${esc(tex)}</code>`;
          console.warn('å…¬å¼æš‚æœªæ’ç‰ˆ:', error.message);
        }
        cursor = pattern.lastIndex;
        previousDisplay = display;
      }
      const tail = paragraph.slice(cursor);
      return out + esc(previousDisplay ? tail.trimStart() : tail).replace(/\n/g, '<br>');
    };
    return `<span class="math-content">${String(value || '').trim().split(/\n\s*\n/).map(p => `<span class="math-paragraph">${renderParagraph(p)}</span>`).join('')}</span>`;
  }
  function examCard(q) {
    const saved = progress.bookmarks.includes(`question:${q.id}`), wrong = progress.wrong.includes(q.id), linkedTopics = arr(q.topicIds).map(id=>topics.get(id)).filter(Boolean), linkedChapters = arr(q.chapterIds).map(id=>chapters.get(id)).filter(Boolean);
    const title = String(q.title || '').replace(/^\d+[.ï¼ã€]\s*/, '');
    return `<article class="exam-card" id="question-${esc(q.id)}">
      <div class="exam-top"><div class="exam-heading-group">
        <div class="exam-metadata">${q.originalNumber ? `<span class="exam-number">é¢˜ ${esc(q.originalNumber)}</span>`:''}<span>${esc(subjectName(q.subject))}</span>${q.year ? `<span class="exam-year">${esc(q.year)}</span>`:''}</div>
        <h2>${esc(title)}</h2>
      </div><div class="topic-actions"><button class="icon-button ${saved?'active':''}" data-action="bookmark" data-id="question:${esc(q.id)}" aria-label="${saved?'å–æ¶ˆæ”¶è—':'æ”¶è—é¢˜ç›®'}" title="${saved?'å–æ¶ˆæ”¶è—':'æ”¶è—é¢˜ç›®'}">${saved?'â˜…':'â˜†'}</button><button class="icon-button" data-action="share" data-hash="${esc(hash({view:'exams',subject:q.subject,question:q.id}))}" aria-label="å¤åˆ¶é¢˜ç›®ä½ç½®" title="å¤åˆ¶é¢˜ç›®ä½ç½®">â†—</button></div></div>
      <div class="exam-prompt">${typesetMath(q.promptFormatted || q.prompt || 'è¯·æŸ¥çœ‹åŸå§‹èµ„æ–™é¡µé¢ã€‚')}</div>
      <div class="exam-reference-row"><div class="knowledge-links"><span>å…³è”çŸ¥è¯†</span>${linkedTopics.map(t=>`<a class="knowledge-chip" href="${hash({view:'subject',subject:t.subject,chapter:t.chapterId,topic:t.id})}">${esc(t.title)} â†—</a>`).join('')}${!linkedTopics.length ? linkedChapters.map(c=>`<a class="knowledge-chip" href="${hash({view:'subject',subject:c.subject,chapter:c.id})}">${esc(c.title)} â†—</a>`).join('') : ''}</div>
      <div class="exam-bottom">${sourceButton(q.sourceId,q.page,'åŸé¢˜')}${q.page?`<span class="subtle">PDF ç¬¬ ${Number(q.page)} é¡µ</span>`:''}<button class="btn btn-small ${wrong?'btn-orange':'btn-light'} footer-link" data-action="wrong" data-id="${esc(q.id)}" aria-pressed="${wrong}">${wrong?'å·²è®°ä¸ºé”™é¢˜ âœ“':'è®°ä¸ºé”™é¢˜'}</button></div></div>
      ${arr(q.hints).length ? `<details class="exam-details"><summary>è§£é¢˜æç¤º</summary><ol>${arr(formatted(q,'hints')).map(h=>`<li>${rich(h)}</li>`).join('')}</ol></details>`:''}
      <details class="exam-details answer-details"><summary>å‚è€ƒç­”æ¡ˆ</summary><div class="reference-answer">${rich(q.answerFormatted)}</div>${arr(q.answerReferences).length ? `<div class="answer-references"><span>æ•™æä¸è¯¾ä»¶</span>${arr(q.answerReferences).map(ref=>sourceButton(ref.sourceId,ref.page,`${ref.label} Â· PDF ${Number(ref.page)} é¡µ`)).join('')}</div>`:''}</details>
    </article>`;
  }
  function examsView() {
    let list = data.questions.filter(q=>(!route.subject || q.subject===route.subject) && (!route.topic || arr(q.topicIds).includes(route.topic)) && (!route.year || String(q.year)===route.year) && (route.filter!=='wrong' || progress.wrong.includes(q.id)) && (route.filter!=='saved' || progress.bookmarks.includes(`question:${q.id}`)));
    if (route.question) list = list.filter(q=>q.id===route.question);
    const page = Math.max(1, Math.min(Math.ceil(list.length / 20) || 1, Number(route.p) || 1)), start = (page-1)*20, shown = list.slice(start,start+20);
    const years = [...new Set(data.questions.filter(q=>!route.subject || q.subject===route.subject).map(q=>q.year).filter(Boolean).map(String))].sort().reverse();
    return mainHeading('QUESTION WORKSHOP',route.filter==='wrong'?'æŠŠé”™é¢˜ï¼Œå˜æˆè‡ªå·±çš„é¢˜ã€‚':'ä¸€é“é¢˜ï¼Œä¸²èµ·ä¸€ç»„çŸ¥è¯†ã€‚','å…ˆç‹¬ç«‹å°è¯•ï¼Œå†æŸ¥çœ‹å…³è”çŸ¥è¯†ä¸åŸå§‹é¢˜é¡µã€‚',route.question||route.topic?`<a class="btn btn-light" href="${hash({view:'exams',subject:route.subject})}">å…¨éƒ¨é¢˜ç›® â†</a>`:'') +
      `<div class="filter-bar">${subjectFilters('exams')}<button class="filter-chip special ${route.filter==='wrong'?'active':''}" data-action="exam-filter" data-filter="wrong">é”™é¢˜æœ¬ ${progress.wrong.filter(id=>questions.has(id)).length}</button><button class="filter-chip ${route.filter==='saved'?'active':''}" data-action="exam-filter" data-filter="saved">æˆ‘çš„æ”¶è—</button>${years.length?`<select class="filter-select" data-select="year" aria-label="æŒ‰å¹´ä»½ç­›é€‰"><option value="">å…¨éƒ¨å¹´ä»½</option>${years.map(y=>`<option value="${esc(y)}" ${route.year===y?'selected':''}>${esc(y)}</option>`).join('')}</select>`:''}</div>${route.topic ? `<div class="info-banner">å½“å‰å…³è”çŸ¥è¯†ï¼š${esc(topics.get(route.topic)?.title || route.topic)} <a class="text-link" href="${hash({view:'exams',subject:route.subject})}">å–æ¶ˆç­›é€‰ Ã—</a></div>`:''}<div class="section-heading"><span class="subtle">${list.length} é“é¢˜ç›®${list.length>20?` Â· ç¬¬ ${page} / ${Math.ceil(list.length/20)} é¡µ`:''}</span><a class="text-link" href="${hash({view:'library',subject:route.subject,category:'å¾€å¹´é¢˜'})}">æŸ¥é˜…å¾€å¹´é¢˜åŸæ–‡ä»¶ â†—</a></div><div class="questions-list">${shown.length?shown.map(examCard).join(''):empty('è¿™é‡Œè¿˜æ²¡æœ‰é¢˜ç›®',route.filter==='wrong'?'é‡åˆ°å¡ä½æˆ–åšé”™çš„é¢˜æ—¶ï¼Œç‚¹å‡»ã€Œè®°ä¸ºé”™é¢˜ã€ï¼Œä¹‹åå°±èƒ½é›†ä¸­å›çœ‹ã€‚':route.filter==='saved'?'ç‚¹å‡»é¢˜ç›®å³ä¸Šè§’çš„æ˜Ÿæ ‡ï¼ŒæŠŠæƒ³å†åšä¸€æ¬¡çš„é¢˜ä¿å­˜åœ¨è¿™é‡Œã€‚':'è¯•è¯•è°ƒæ•´ç­›é€‰æ¡ä»¶ï¼Œæˆ–ç›´æ¥æ‰“å¼€åŸå§‹å‚è€ƒèµ„æ–™ã€‚')}</div>${list.length>20?`<div class="review-status"><button class="btn btn-light" data-action="exam-page" data-page="${page-1}" ${page<=1?'disabled':''}>â† ä¸Šä¸€é¡µ</button><span>ç¬¬ ${start+1}â€“${Math.min(start+20,list.length)} é“ / å…± ${list.length} é“</span><button class="btn btn-light" data-action="exam-page" data-page="${page+1}" ${start+20>=list.length?'disabled':''}>ä¸‹ä¸€é¡µ â†’</button></div>`:''}`;
  }

  function buildReview() {
    const candidates = subjectTopics(route.subject).filter(t=>route.filter!=='saved'||progress.bookmarks.includes(`topic:${t.id}`));
    const due = candidates.filter(t=>progress.topicProgress[t.id]?.due <= today());
    const fresh = candidates.filter(t=>!progress.topicProgress[t.id]?.level && !due.includes(t));
    reviewQueue = [...due,...fresh].slice(0,20).map(t=>t.id);
    if (!reviewQueue.length && route.practice==='all') reviewQueue = candidates.slice(0,20).map(t=>t.id);
    reviewIndex = 0; reviewRevealed = false; reviewSessionCount = 0;
  }
  function reviewView() {
    const id = reviewQueue[reviewIndex], t = topics.get(id), done = reviewIndex >= reviewQueue.length && reviewQueue.length > 0;
    let content;
    if (done) content = `<div class="flashcard review-complete"><div class="complete-symbol">âœ“</div><h2>è¿™ä¸€è½®ï¼Œç§¯ç´¯ä¸‹æ¥äº†ã€‚</h2><p>å®Œæˆ ${reviewSessionCount} æ¬¡ä¸»åŠ¨å›å¿†ã€‚ä¸‹æ¬¡å¤ä¹ æ—¶é—´å·²æŒ‰ä½ çš„åé¦ˆæ›´æ–°ã€‚</p><a class="btn btn-primary" href="${hash({view:'exams',subject:route.subject})}">ç”¨ä¸€é“é¢˜æ£€éªŒç†è§£ â†’</a><button class="btn btn-light" data-action="review-restart" style="margin-left:8px">å†æ¥ä¸€è½®</button></div>`;
    else if (!t) content = empty('ä»Šå¤©çš„åˆ°æœŸå¤ä¹ å·²å®Œæˆ',route.filter==='saved'?'æ”¶è—çš„çŸ¥è¯†ç‚¹ä¼šå‡ºç°åœ¨è¿™é‡Œï¼Œä½ ä¹Ÿå¯ä»¥ä¸»åŠ¨é‡æ¸©å·²ç»æŒæ¡çš„å†…å®¹ã€‚':'å¯ä»¥ç»§ç»­ç»ƒé¢˜ï¼Œæˆ–æå‰å›å¿†å·²ç»å­¦è¿‡çš„çŸ¥è¯†ç‚¹ã€‚',`<button class="btn btn-primary" data-action="review-all">æå‰å¤ä¹ å·²å­¦å†…å®¹</button>`);
    else content = `<div class="review-status"><span>${esc(subjectName(t.subject))} Â· ${esc(chapters.get(t.chapterId)?.title || '')}</span><span>${reviewIndex+1} / ${reviewQueue.length}</span></div><div class="progress-track"><div class="progress-fill" style="width:${Math.round(reviewIndex/reviewQueue.length*100)}%"></div></div><article class="flashcard" style="margin-top:16px"><div class="eyebrow">RECALL BEFORE YOU REVEAL</div><h2>${esc(t.title)}</h2><p class="flashcard-prompt">è¯´å‡ºå‡†ç¡®è¡¨è¿°ä¸å¿…è¦æ¡ä»¶ï¼Œå¹¶å°è¯•è§£é‡Šè¯æ˜çš„å…³é”®ä¸€æ­¥ã€‚</p>${arr(t.questionPrompts).length ? `<div class="prompt-block"><ul>${arr(formatted(t,'questionPrompts')).map(p=>`<li>${rich(p)}</li>`).join('')}</ul></div>`:''}${reviewRevealed?`<div class="flashcard-answer"><div class="topic-statement">${rich(formatted(t,'statement'))}</div>${t.proofIdea?`<div class="proof-block">${rich(formatted(t,'proofIdea'))}</div>`:''}${arr(t.pitfalls).length?`<div class="pitfall-block"><strong>æ£€æŸ¥é—æ¼çš„æ¡ä»¶</strong><ul>${arr(formatted(t,'pitfalls')).map(p=>`<li>${rich(p)}</li>`).join('')}</ul></div>`:''}<div class="source-line"><a class="text-link" href="${hash({view:'subject',subject:t.subject,chapter:t.chapterId,topic:t.id})}">å›åˆ°å®Œæ•´çŸ¥è¯†å¡ç‰‡ â†—</a>${sourceButton(t.sourceId,t.sourcePage)}</div></div>`:`<div class="flashcard-reveal"><button class="btn btn-primary" data-action="review-reveal">æˆ‘å·²å°è¯•å›å¿†ï¼ŒæŸ¥çœ‹è¦ç‚¹</button></div>`}</article>${reviewRevealed?`<div class="rating-bar"><button class="rating-button" data-action="review-rate" data-level="0">è¿˜æ²¡æƒ³èµ·æ¥<small>æœ¬è½®å†çœ‹ä¸€æ¬¡</small></button><button class="rating-button" data-action="review-rate" data-level="1">æœ‰äº›åƒåŠ›<small>1 å¤©åå¤ä¹ </small></button><button class="rating-button" data-action="review-rate" data-level="2">åŸºæœ¬è¯´æ¸…<small>3 å¤©åå¤ä¹ </small></button><button class="rating-button" data-action="review-rate" data-level="3">å®Œæ•´æŒæ¡<small>7 å¤©åå¤ä¹ </small></button></div>`:''}<p class="review-support">æŒ‰è‡ªæˆ‘å›å¿†æƒ…å†µè¯„åˆ†ã€‚è¿™é‡Œä½¿ç”¨å›ºå®šé—´éš”å¤ä¹ ï¼Œä¸æ˜¯è€ƒè¯•åˆ†æ•°æˆ–èƒ½åŠ›è¯„ä¼°ã€‚</p>`;
    return mainHeading('ACTIVE RECALL','åˆä¸Šä¹¦ï¼Œè¯•ç€è®²å‡ºæ¥ã€‚','ä¸æ€¥ç€çœ‹ç­”æ¡ˆã€‚æŠŠå®šä¹‰ã€æ¡ä»¶ã€è¯æ˜è·¯çº¿ç”¨è‡ªå·±çš„è¯è¯´ä¸€éã€‚')+`<div class="filter-bar">${subjectFilters('review')}<button class="filter-chip special ${route.filter==='saved'?'active':''}" data-action="review-filter">åªçœ‹æ”¶è—</button></div><div class="review-wrap">${content}</div>`;
  }

  function libraryView() {
    const categories = [...new Set(data.sources.map(s=>s.category).filter(Boolean))];
    const list = data.sources.filter(s=>(!route.subject||s.subject===route.subject)&&(!route.category||s.category===route.category));
    const content = list.map(s => {
      const scan = !Number(s.textPages), primary = isPrimarySource(s), past = /å¾€å¹´é¢˜/.test(s.category || '');
      return `<article class="source-card"><div class="source-book">${past?'Q':'âˆ‘'}</div><div class="source-details"><h3>${esc(s.title)}</h3><div class="source-meta"><span>${esc(subjectName(s.subject))}</span><span>Â·</span><span>${esc(s.category || 'å‚è€ƒèµ„æ–™')}</span><span>Â·</span><span>${Number(s.pages)||'?'} é¡µ</span></div><div class="source-meta"><span class="tag ${primary?'green':past?'blue':'gray'}">${primary?'æŒ‡å®šä¸»èµ„æ–™':past?'å¾€å¹´é¢˜èµ„æ–™':'è¾…åŠ©èµ„æ–™'}</span><span class="tag ${scan?'orange':'blue'}">${scan?'æ‰«æèµ„æ–™ Â· æ— å¯æ£€ç´¢æ–‡å­—':`å¯æ£€ç´¢æ–‡å­— ${Number(s.textPages)} é¡µ`}</span>${s.duplicateOf?'<span class="tag gray">åŒå†…å®¹å‰¯æœ¬</span>':''}</div>${s.available===false?'<div class="source-warning">èµ„æ–™æ–‡ä»¶æœªæ‰¾åˆ°ï¼Œè¯·è¡¥é½é…å¥—èµ„æ–™ç›®å½•åå†é˜…è¯»ã€‚</div>':`<div class="source-actions"><button data-action="source" data-source="${esc(s.id)}" data-page="1">æµè§ˆåŸæ–‡ â†—</button>${fullPdfLink(s)}${!scan?`<a href="${hash({view:'search',subject:s.subject})}">æ£€ç´¢èµ„æ–™æ–‡å­— â†’</a>`:''}</div>`}</div></article>`;
    }).join('');
    return mainHeading('SOURCE LIBRARY','æ‰€æœ‰çŸ¥è¯†ï¼Œéƒ½æœ‰æ¥å¤„ã€‚','æ•™æä¸è¯¾ä»¶ã€å¾€å¹´é¢˜æ˜¯å¤ä¹ ä¸»çº¿ã€‚ç¬”è®°å’Œä¹ é¢˜ä½œä¸ºè¾…åŠ©ï¼Œæ‰€æœ‰èµ„æ–™å‡ç”±æœ¬æœºæä¾›ã€‚') + `<div class="filter-bar">${subjectFilters('library')}<select class="filter-select" data-select="category" aria-label="æŒ‰èµ„æ–™ç±»å‹ç­›é€‰"><option value="">å…¨éƒ¨èµ„æ–™ç±»å‹</option>${categories.map(c=>`<option value="${esc(c)}" ${route.category===c?'selected':''}>${esc(c)}</option>`).join('')}</select></div><div class="info-banner">æ‰«æ PDF å¯ä»¥é€é¡µé˜…è¯»ï¼Œä½†æ²¡æœ‰æ–‡å­—å±‚çš„é¡µé¢æ— æ³•å…¨æ–‡æ£€ç´¢ã€‚çŸ¥è¯†å¡ç‰‡ä¸é¢˜ç›®ç´¢å¼•å¯ç‹¬ç«‹æœç´¢ï¼›åŸæ–‡ä¸­çš„å°åˆ·é¡µç å¯èƒ½ä¸è¿™é‡Œçš„ PDF é¡µåºä¸åŒã€‚</div><div class="section-heading"><span class="subtle">å½“å‰ ${list.length} ä»½èµ„æ–™</span><span class="subtle">åŸæ–‡ä»¶ä¿ç•™åœ¨æœ¬åœ°èµ„æ–™ç›®å½•</span></div><div class="library-grid">${content || empty('æ²¡æœ‰ç¬¦åˆæ¡ä»¶çš„èµ„æ–™','è¯·é€‰æ‹©å…¶ä»–è¯¾ç¨‹æˆ–èµ„æ–™ç±»å‹ã€‚')}</div>`;
  }

  function highlight(value, query) {
    const text = txt(value), terms = query.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean), lower = text.toLocaleLowerCase();
    let first = terms.reduce((n,t)=>{const i=lower.indexOf(t);return i<0?n:Math.min(n,i);},Infinity), snippet=text;
    if (text.length>230) { const start=Number.isFinite(first)?Math.max(0,first-65):0; snippet=(start?'â€¦':'')+text.slice(start,start+230)+(start+230<text.length?'â€¦':''); }
    if (!terms.length) return esc(snippet);
    const regex = new RegExp(terms.map(t=>t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('|'),'gi');
    let result = '', cursor = 0, match;
    while ((match=regex.exec(snippet)) !== null) { result += esc(snippet.slice(cursor,match.index)) + `<mark>${esc(match[0])}</mark>`;cursor=match.index+match[0].length; }
    return result + esc(snippet.slice(cursor));
  }
  function searchView() {
    const query=(route.q||'').trim(), terms=query.toLocaleLowerCase().split(/\s+/).filter(Boolean), match=value=>terms.every(t=>txt(value).toLocaleLowerCase().includes(t));
    const topicMatches = query ? [...topics.values()].filter(t=>(!route.subject||t.subject===route.subject)&&match([t.title,t.statement,t.proofIdea,t.pitfalls,t.questionPrompts])) : [];
    const chapterMatches = query ? [...chapters.values()].filter(c=>(!route.subject||c.subject===route.subject)&&match([c.title,c.summary])) : [];
    const questionMatches = query ? data.questions.filter(q=>(!route.subject||q.subject===route.subject)&&match([q.title,q.prompt,q.year])) : [];
    const group=(label,list,renderItem)=>list.length?`<section class="search-group"><h2>${label} <span class="count-pill">${list.length}</span></h2>${list.slice(0,30).map(renderItem).join('')}${list.length>30?'<p class="subtle">æ˜¾ç¤ºå‰ 30 é¡¹ï¼Œè¯·å¢åŠ å…³é”®è¯ä»¥ç¼©å°èŒƒå›´ã€‚</p>':''}</section>`:'';
    return mainHeading('FIND A CONNECTION','ä»ä¸€ä¸ªé—®é¢˜ï¼Œæ‰¾åˆ°çŸ¥è¯†ã€‚','å…ˆæŸ¥å·²æ•´ç†çš„çŸ¥è¯†ä¸é¢˜ç›®ï¼Œå†æŒ‰éœ€æ£€ç´¢æœ‰æ–‡å­—å±‚çš„åŸå§‹èµ„æ–™ã€‚') + `<form class="search-box" id="page-search-form"><input type="search" name="q" aria-label="è¾“å…¥å…³é”®è¯" placeholder="ä¾‹å¦‚ï¼šæ­£è§„å­ç¾¤ã€ä¸åŠ¨ç‚¹ã€æµ‹åœ°çº¿â€¦" value="${esc(query)}" autofocus><button class="btn btn-primary" type="submit">æœç´¢</button></form><div class="filter-bar">${subjectFilters('search')}</div>${query ? `<p class="search-summary">â€œ${esc(query)}â€ Â· æ‰¾åˆ° ${topicMatches.length+chapterMatches.length+questionMatches.length} ä¸ªæœ¬åœ°ç´¢å¼•ç»“æœ</p>${group('çŸ¥è¯†ç‚¹',topicMatches,t=>`<a class="search-result" href="${hash({view:'subject',subject:t.subject,chapter:t.chapterId,topic:t.id})}"><small>${esc(subjectName(t.subject))} / ${esc(chapters.get(t.chapterId)?.title)}</small><h3>${highlight(t.title,query)}</h3><p>${highlight(t.statement,query)}</p></a>`)}${group('ç« èŠ‚',chapterMatches,c=>`<a class="search-result" href="${hash({view:'subject',subject:c.subject,chapter:c.id})}"><small>${esc(subjectName(c.subject))}</small><h3>${highlight(c.title,query)}</h3><p>${highlight(c.summary,query)}</p></a>`)}${group('é¢˜ç›®',questionMatches,q=>`<a class="search-result" href="${hash({view:'exams',subject:q.subject,question:q.id})}"><small>${esc(subjectName(q.subject))} Â· ${esc(q.year||'å¹´ä»½æœªæ³¨æ˜')}</small><h3>${highlight(q.title,query)}</h3><p>${highlight(q.prompt,query)}</p></a>`)}${!topicMatches.length&&!chapterMatches.length&&!questionMatches.length?empty('æš‚æ—¶æ²¡æœ‰ç´¢å¼•åŒ¹é…','å¯ä»¥æ¢ä¸€ä¸ªæ›´çŸ­çš„æ•°å­¦æœ¯è¯­ï¼Œæˆ–ç»§ç»­æ£€ç´¢åŸæ–‡æ–‡å­—ã€‚'):''}<section class="search-group"><div class="section-heading"><h2>åŸå§‹èµ„æ–™å…¨æ–‡æ£€ç´¢</h2><button class="btn btn-light btn-small" data-action="source-search">æ£€ç´¢åŸæ–‡æ–‡å­—</button></div><div id="source-search-results"><div class="info-banner">ä»…æœç´¢æœ¬åœ° PDF çš„å¯æå–æ–‡å­—ï¼Œæ‰«æé¡µä¸å‚ä¸å…¨æ–‡æ£€ç´¢ã€‚ä¸ä¼šè¿æ¥ç½‘ç»œæˆ–è°ƒç”¨å¤–éƒ¨ APIã€‚</div></div></section>` : empty('æŠŠç°åœ¨å¡ä½çš„æ¦‚å¿µå†™ä¸‹æ¥','æ”¯æŒç« èŠ‚åç§°ã€çŸ¥è¯†ç‚¹ã€é¢˜å¹²å’Œèµ„æ–™æ­£æ–‡ï¼›å¤šä¸ªå…³é”®è¯ç”¨ç©ºæ ¼åˆ†éš”ã€‚')}`;
  }
  async function searchSources() {
    const el=$('#source-search-results'); if(!el)return;
    const token=++searchToken, query=route.q||'';
    el.innerHTML='<div class="info-banner">æ­£åœ¨æ£€ç´¢æœ¬åœ°èµ„æ–™æ–‡å­—â€¦</div>';
    try {
      let result;
      if(platform) result=await platform.search(query,route.subject||'');
      else { const response=await fetch(`/api/search?${new URLSearchParams({q:query,subject:route.subject||''})}`);if(!response.ok)throw new Error(`æ£€ç´¢æœåŠ¡è¿”å› ${response.status}`);result=await response.json(); }
      if(token!==searchToken||!el.isConnected)return;
      const found=arr(result.results);
      el.innerHTML=found.length?`<p class="subtle">æ‰¾åˆ° ${found.length} ä¸ªé¡µé¢${result.truncated?'ï¼Œå½“å‰ä»…æ˜¾ç¤ºéƒ¨åˆ†åŒ¹é…ï¼Œè¯·å¢åŠ å…³é”®è¯ç¼©å°èŒƒå›´':''}</p>${found.map(r=>`<button class="search-result" style="width:100%;text-align:left" data-action="source" data-source="${esc(r.sourceId)}" data-page="${Number(r.page)||1}"><small>PDF ç¬¬ ${Number(r.page)||1} é¡µ</small><h3>${esc(r.title||sourceFor(r.sourceId)?.title)}</h3><p>${highlight(r.snippet,query)}</p></button>`).join('')}`:empty('åŸæ–‡æ–‡å­—ä¸­æ²¡æœ‰åŒ¹é…','æ‰«æé¡µæ— æ³•å‚ä¸æ£€ç´¢ã€‚ä½ ä»å¯æŒ‰çŸ¥è¯†å¡ç‰‡çš„æ¥æºå®šä½é˜…è¯»åŸæ–‡ã€‚');
    } catch(e) { if(token===searchToken&&el.isConnected)el.innerHTML=`<div class="info-banner orange">å…¨æ–‡æ£€ç´¢æœªå®Œæˆï¼š${esc(e.message)}ã€‚è¯·ç¡®è®¤æœ¬åœ°ç¨‹åºä»åœ¨è¿è¡Œåé‡è¯•ã€‚</div>`; }
  }

  function settingsView() {
