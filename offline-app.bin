    if (!manifestLength || manifestLength > MAX_MANIFEST || bodyOffset >= file.size) throw new Error('èµ„æ–™åŒ…ç›®å½•é•¿åº¦ä¸æ­£ç¡®ï¼Œæ–‡ä»¶å¯èƒ½æœªä¸‹è½½å®Œæ•´ã€‚');
