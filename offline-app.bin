    document.body.classList.add('ipad-onboarding');
    document.querySelector('#main-nav')?.replaceChildren(); document.querySelector('#subject-nav')?.replaceChildren();
    main.innerHTML = `<section class="ipad-welcome"><div class="eyebrow">YOUR OFFLINE STUDY DESK</div><span class="ipad-welcome-mark" aria-hidden="true">ç ”</span><h1>æŠŠæ•´å¥—å¤ä¹ èµ„æ–™ï¼Œå¸¦åœ¨ iPad ä¸Šã€‚</h1><p class="ipad-welcome-lead">ç« èŠ‚ã€é¢˜ç›®ã€å‚è€ƒç­”æ¡ˆå’Œæ•™æï¼Œå¯¼å…¥ä¸€æ¬¡ï¼Œä¹‹åæ–­ç½‘ä¹Ÿèƒ½é˜…è¯»ã€‚</p><ol class="ipad-install-steps"><li><span>1</span><div><strong>æ·»åŠ åˆ°ä¸»å±å¹•</strong><p>åœ¨ Safari ä¸­ç‚¹â€œåˆ†äº« â†’ æ·»åŠ åˆ°ä¸»å±å¹•â€ï¼Œå†ä»ä¸»å±å¹•çš„ç ”ä¹ å›¾æ ‡æ‰“å¼€ã€‚é¦–æ¬¡æ‰“å¼€æ—¶ä¿æŒè”ç½‘ã€‚</p></div></li><li><span>2</span><div><strong>å¯¼å…¥é…å¥—èµ„æ–™åŒ…</strong><p>æŠŠ .yanxi èµ„æ–™åŒ…ä¿å­˜åˆ°â€œæ–‡ä»¶â€App çš„â€œæˆ‘çš„ iPadâ€ã€‚åº”ç”¨å‡†å¤‡å®Œæˆåï¼Œåœ¨è¿™é‡Œé€‰æ‹©å®ƒã€‚å¯¼å…¥æ—¶è¯·ä¿æŒæœ¬åº”ç”¨åœ¨å‰å°ã€‚</p></div></li><li><span>3</span><div><strong>å¼€å¯é£è¡Œæ¨¡å¼ï¼Œè¯•è¯»ä¸€é¡µ</strong><p>æ‰“å¼€ä¸€é“é¢˜çš„å‚è€ƒç­”æ¡ˆï¼Œå†ç‚¹æ•™æé“¾æ¥ç¿»é¡µã€‚ç¡®è®¤æ­£å¸¸åï¼Œå°±å¯ä»¥å¸¦ç€ iPad å‡ºå‘äº†ã€‚</p></div></li></ol><div class="ipad-onboarding-state" role="status" aria-live="polite">${esc(message)}</div><div class="ipad-welcome-import"></div><p class="ipad-storage-note">èµ„æ–™ä¿å­˜åœ¨æœ¬æœºï¼›æ¸…ç†ç½‘ç«™æ•°æ®æˆ–åˆ é™¤åº”ç”¨å¯èƒ½æ¸…é™¤èµ„æ–™å’Œè¿›åº¦ã€‚è¯·ä¿ç•™åŸèµ„æ–™åŒ…ï¼Œå¹¶å®šæœŸåœ¨è®¾ç½®ä¸­å¯¼å‡ºå­¦ä¹ å¤‡ä»½ã€‚</p></section>`;
    if (canImport) main.querySelector('.ipad-welcome-import').append(importControl({initial:true}));
    else if (!isIPad() || isStandalone()) {
      const retry = document.createElement('button'); retry.className = 'btn btn-light'; retry.textContent = 'é‡æ–°æ£€æŸ¥'; retry.addEventListener('click', () => location.reload());
      main.querySelector('.ipad-welcome-import').append(retry);
    }
  }

  async function runUpdateAction(action) {
    if (updateActionBusy) return;
    if (importBusy) { updateActionError='è¯·ç­‰å¾…èµ„æ–™å¯¼å…¥å®Œæˆåå†æ›´æ–°åº”ç”¨ã€‚';updateOfflineUI();return; }
    updateActionBusy=true;updateActionError='';updateOfflineUI();
    try { await window.YanxiOffline[action](); }
    catch (error) { updateActionError=friendlyError(error); }
    finally { updateActionBusy=false;updateOfflineUI(); }
  }
  function mountUpdatePanel(grid) {
    if (document.querySelector('#ipad-app-update')) return;
    const panel=document.createElement('section');panel.id='ipad-app-update';panel.className='panel settings-panel ipad-app-update';
    panel.innerHTML=`<div class="ipad-panel-heading"><h2>åº”ç”¨æ›´æ–°</h2><span class="tag green">å½“å‰ç‰ˆæœ¬ ${esc(window.YanxiSecurity?.version || '')}</span></div><p>æ›´æ–°ç¨‹åºä¼šä¿ç•™æœ¬æœºæ•™æã€ç¬”è®°å’Œå­¦ä¹ è¿›åº¦ã€‚</p><p class="ipad-update-status" role="status" aria-live="polite"></p><div class="ipad-update-actions"><button class="btn btn-primary" type="button" data-update-action="check">æ£€æŸ¥æ›´æ–°</button><button class="btn btn-light" type="button" data-update-action="activate" hidden>å¯ç”¨æ–°ç‰ˆ</button></div><progress class="ipad-import-progress" max="100" hidden aria-label="åº”ç”¨æ›´æ–°è¿›åº¦"></progress>`;
    panel.querySelector('[data-update-action=check]').addEventListener('click',()=>runUpdateAction('checkForUpdate'));
    panel.querySelector('[data-update-action=activate]').addEventListener('click',()=>runUpdateAction('activateUpdate'));
    grid.prepend(panel);updateOfflineUI();
  }
  function updateOfflineUI() {
    const status=window.YanxiOffline?.status?.(); if (!status) return;
    for (const control of document.querySelectorAll('.ipad-import-control button,.ipad-import-control input')) control.disabled=updateActionBusy || importBusy;
    if (startupWaiting) {
      const message=document.querySelector('#ipad-install-message'), bar=document.querySelector('#ipad-install-progress');
      if (message) message.textContent=status.message+(status.phase==='downloading' && status.totalBytes>0 ? ` ${Math.min(100,Math.floor(100*status.bytes/status.totalBytes))}%` : '');
      if (bar) {
        const total=status.phase==='downloading'?status.totalBytes:status.total;
        const completed=status.phase==='downloading'?status.bytes:status.completed;
        if (total>0) bar.value=Math.max(0,Math.min(100,100*completed/total));
        else bar.removeAttribute('value');
      }
      return;
    }
    const panel=document.querySelector('#ipad-app-update');
