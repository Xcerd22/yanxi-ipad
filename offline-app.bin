  async function inspectBundle(file) {
    if (!(file instanceof Blob) || file.size < 22 || file.size > MAX_BUNDLE) throw new Error('è¯·é€‰æ‹©å®Œæ•´çš„ .yanxi èµ„æ–™åŒ…ï¼ˆæœ€å¤§ 2 GBï¼‰ã€‚');
    const headerSize = MAGIC.length + 4;
