@media(max-width:760px){.sidebar{transform:translateX(-100%);transition:transform .2s;width:248px;z-index:50}.sidebar.open{transform:translateX(0)}.sidebar-scrim.open{display:block;position:fixed;inset:0;z-index:40;background:#21382670}.workspace{margin-left:0}.menu-button{display:grid}.topbar{height:66px;padding:0 18px;gap:13px}.breadcrumb{min-width:0;font-size:11px}.global-search{max-width:300px}.global-search input{font-size:11px}.global-search kbd{display:none}#main{padding:25px 20px 20px}.page-heading{margin-bottom:20px;align-items:flex-start}.page-heading h1{font-size:27px}.page-heading p{font-size:11px}.heading-actions .btn{padding:8px 10px;min-height:35px;font-size:10px}.hero{padding:23px;grid-template-columns:1fr 105px;gap:15px}.hero h2{font-size:20px}.hero-number{font-size:44px}.hero p{font-size:11px}.hero-aside p{font-size:9px}.hero-actions{gap:7px;margin-top:17px}.hero-actions .btn{font-size:11px;padding:8px 11px}.stats-grid{margin:16px 0 23px;grid-template-columns:repeat(4,1fr);gap:8px}.stat-card{padding:12px 11px;border-radius:9px}.stat-top{font-size:9px}.stat-symbol{display:none}.stat-value{font-size:27px}.stat-note{font-size:8px}.subject-card{padding:17px}.subject-glyph{width:38px;height:40px;font-size:22px}.subject-card-top{gap:11px}.subject-card h3{font-size:14px}.subject-card .en-title{font-size:8px;letter-spacing:1px}.subject-card-description{font-size:10px}.subject-meta{gap:10px;font-size:9px}.section-heading h2{font-size:16px}.workspace-footer{padding:17px 20px 24px;flex-direction:column;gap:4px;font-size:9px}.topic-card{scroll-margin-top:83px}.chapter-intro{padding:21px}.chapter-intro h2{font-size:22px}.exam-card{padding:21px}.modal-backdrop{padding:8px}.source-modal{width:100%;height:96vh;border-radius:10px}.page-image-wrap{padding:9px}.modal-header{padding:12px 15px}.modal-header h2{font-size:11px}.modal-footer{font-size:9px}.modal-toolbar{gap:7px}.subject-banner{padding:17px}.subject-banner .subject-glyph{width:42px;height:47px;font-size:25px}.subject-banner h2{font-size:18px}.subject-banner p{font-size:10px}.subject-banner .subject-stats{min-width:70px}.subject-stats strong{font-size:24px}}
@media(max-width:480px){#main{padding:22px 15px 16px}.topbar{padding:0 12px;gap:9px}.breadcrumb{max-width:90px;overflow:hidden;text-overflow:ellipsis}.global-search input{font-size:10px}.global-search{gap:7px}.global-search span{font-size:21px}.page-heading{gap:10px}.page-heading h1{font-size:25px}.page-heading .heading-actions .btn{min-height:31px;padding:6px 9px}.page-heading .heading-actions .hide-small{display:none}.hero{grid-template-columns:1fr;padding:22px}.hero-aside{position:absolute;right:24px;top:20px}.hero-number{font-size:33px}.hero-aside p{max-width:85px;font-size:8px}.hero h2{max-width:225px;padding-right:40px;font-size:20px}.hero>div:first-child>p{padding-right:75px;font-size:10px}.hero:after{right:-150px}.hero:before{right:-90px}.hero-actions .btn{font-size:10px}.stats-grid{grid-template-columns:repeat(2,1fr);gap:10px}.stat-card{padding:14px 15px}.stat-top{font-size:10px}.stat-symbol{display:block;font-size:13px}.stat-note{font-size:9px}.stat-value{font-size:29px;margin:6px 0}.subject-grid{grid-template-columns:1fr;gap:12px}.subject-card-description{min-height:0;margin:13px 0}.subject-card .en-title{font-size:9px}.subject-card h3{font-size:16px}.subject-glyph{width:42px;height:44px}.subject-meta{margin-top:11px}.dashboard-side{grid-template-columns:1fr}.quote-panel{display:none}.question-preview{padding:12px}.question-preview .tag{display:none}.chapter-index{grid-template-columns:1fr;max-height:225px}.subject-banner{gap:11px}.subject-banner .subject-stats{display:none}.chapter-intro{padding:20px}.topic-card{padding:20px 17px}.topic-title h3{font-size:15px}.topic-title{gap:8px}.topic-actions{margin-right:-6px}.topic-actions .icon-button{width:29px}.topic-statement{font-size:12px}.exam-card{padding:19px 17px}.exam-top{gap:6px}.exam-card h2{font-size:16px}.exam-prompt{font-size:12px}.filter-chip{font-size:10px;padding:6px 10px}.filter-bar{gap:6px}.filter-chip.special{margin-left:0}.filter-select{max-width:100%;font-size:10px}.flashcard{padding:25px 21p