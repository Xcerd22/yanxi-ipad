    return mainHeading('MAKE IT YOURS','æŒ‰è‡ªå·±çš„èŠ‚å¥ï¼Œå‡†å¤‡ã€‚','è®¾ç½®è€ƒè¯•æ—¶é—´ï¼Œä¿ç•™å­¦ä¹ ç§¯ç´¯ã€‚è½¯ä»¶å’Œèµ„æ–™å¯ç¦»çº¿ä½¿ç”¨ï¼Œä¸ªäººè¿›åº¦ä¿å­˜åœ¨å½“å‰æµè§ˆå™¨ä¸­ã€‚') +
      `${!storageAvailable?'<div class="info-banner orange">æµè§ˆå™¨æœ¬åœ°å­˜å‚¨ä¸å¯ç”¨æˆ–ä¸Šæ¬¡ä¿å­˜å¤±è´¥ï¼Œè¯·å…ˆå¯¼å‡ºå¤‡ä»½ä»¥å…ä¸¢å¤±è¿›åº¦ã€‚</div>':''}<div class="settings-grid"><section class="panel settings-panel"><h2>æˆ‘çš„å¤ä¹ è®¡åˆ’</h2><p>ç”¨è€ƒè¯•æ—¥æœŸä½œä¸ºæé†’ï¼Œä»¥æ¯å¤©èƒ½æŒç»­æŠ•å…¥çš„æ—¶é—´å®‰æ’å­¦ä¹ ã€‚</p><form id="settings-form"><label class="form-field">è€ƒè¯•æ—¥æœŸ<input type="date" name="examDate" value="${esc(progress.examDate)}"><small>å°šæœªç¡®å®šæ—¶å¯ç•™ç©ºã€‚è®¾ç½®æ—¥æœŸä¸ä¼šæ”¹å˜é¢˜ç›®èŒƒå›´ã€‚</small></label><label class="form-field">æ¯æ—¥å»ºè®®å­¦ä¹ æ—¶é—´ï¼ˆåˆ†é’Ÿï¼‰<input type="number" name="dailyMinutes" min="10" max="600" step="5" required value="${progress.dailyMinutes}"><small>ä½œä¸ºè‡ªå·±çš„æ¯æ—¥å­¦ä¹ æ—¶é—´ç›®æ ‡ã€‚</small></label><div class="settings-actions"><button class="btn btn-primary" type="submit">ä¿å­˜è®¾ç½®</button></div></form></section><section class="panel settings-panel"><h2>å­¦ä¹ è¿›åº¦ä¸å¤‡ä»½</h2><p>ç¬”è®°ã€æ”¶è—ã€é”™é¢˜ä¸å›å¿†è®°å½•åªä¿å­˜åœ¨å½“å‰æµè§ˆå™¨ã€‚å‘é€è½¯ä»¶ä¸ä¼šè‡ªåŠ¨å¸¦èµ°ä½ çš„ä¸ªäººè¿›åº¦ï¼›æ›´æ¢ç”µè„‘æˆ–æµè§ˆå™¨æ—¶ï¼Œç”¨å¤‡ä»½æ–‡ä»¶è¿ç§»ã€‚</p><div class="backup-status">${learnedCount()} ä¸ªå·²å­¦çŸ¥è¯†ç‚¹ Â· ${notesCount} æ¡ç¬”è®° Â· ${progress.bookmarks.length} ä¸ªæ”¶è— Â· ${progress.wrong.length} é“é”™é¢˜<br>${progress.lastBackup?`æœ€è¿‘å¯¼å‡ºï¼š${esc(progress.lastBackup)}`:'è¿˜æ²¡æœ‰å¯¼å‡ºè®°å½•ã€‚å»ºè®®æ¯æ¬¡å®Œæˆè¾ƒå¤šç¬”è®°åå¯¼å‡ºä¸€ä»½ã€‚'}</div><div class="settings-actions"><button class="btn btn-primary" data-action="export">å¯¼å‡ºå­¦ä¹ å¤‡ä»½ â†“</button><button class="btn btn-light" data-action="import">å¯¼å…¥å¤‡ä»½ â†‘</button><input class="import-input" id="import-file" type="file" accept=".json,application/json"></div><p class="subtle" style="margin-top:13px">å¯¼å…¥æ—¶æŒ‰æ¡ç›®åˆå¹¶ï¼Œå¤‡ä»½ä¸­ç›¸åŒæ¡ç›®çš„è®°å½•è¦†ç›–æœ¬æœºè®°å½•ã€‚è½¯ä»¶ä¼šå…ˆè‡ªåŠ¨å¯¼å‡ºæœ¬æœºå¤‡ä»½ã€‚</p></section></div>`;
  }

  function render() {
    if(!ready)return;
    const prior=route; route={view:'dashboard',...currentRoute()};
    if(!['dashboard','subject','exams','review','library','search','settings'].includes(route.view))route.view='dashboard';
    if(route.subject && !subjects.has(route.subject))delete route.subject;
    searchToken++;
    if(route.view==='review'&&(prior.view!=='review'||prior.subject!==route.subject||prior.filter!==route.filter||prior.practice!==route.practice))buildReview();
    const views={dashboard,subject:subjectView,exams:examsView,review:reviewView,library:libraryView,search:searchView,settings:settingsView};
    $('#main').innerHTML=views[route.view](); renderNav(); closeSidebar();
    platform?.afterRender(data,route);
    if(route.view==='search')$('#search-input').value=route.q||'';
    if(route.topic&&route.view==='subject')requestAnimationFrame(()=>document.getElementById(`topic-${route.topic}`)?.scrollIntoView({block:'start'}));
    else if(route.question&&route.view==='exams')requestAnimationFrame(()=>document.getElementById(`question-${route.question}`)?.scrollIntoView({block:'start'}));
    else window.scrollTo({top:0,behavior:'instant'});
  }

  function clampPage(source,page) { return Math.max(1,Math.min(Number(source.pages)||99999,Math.floor(Number(page)||1))); }
  function openSource(id,page=1) {
    const source=sourceFor(id); if(!source){toast('æ‰¾ä¸åˆ°è¿™ä»½èµ„æ–™çš„ç´¢å¼•ã€‚');return;} if(source.available===false){toast('èµ„æ–™æ–‡ä»¶æœªæ‰¾åˆ°ï¼Œè¯·è¡¥é½é…å¥—èµ„æ–™ç›®å½•åå†é˜…è¯»ã€‚');return;}
    modalPreviousFocus=document.activeElement; modalSource=source; modalPage=clampPage(source,page);
    $('#modal-root').innerHTML=`<div class="modal-backdrop" data-action="modal-backdrop"><section class="source-modal" role="dialog" aria-modal="true" aria-labelledby="source-modal-title"><header class="modal-header"><div><h2 id="source-modal-title">${esc(source.title)}</h2><small>${esc(subjectName(source.subject))} Â· ${esc(source.category)} Â· PDF é¡µåº</small></div><button class="icon-button" data-action="source-close" aria-label="å…³é—­åŸæ–‡é˜…è¯»å™¨">âœ•</button></header><div class="modal-toolbar"><button class="btn btn-light btn-small" data-action="source-prev">â† ä¸Šä¸€é¡µ</button><label><span class="sr-only">PDF é¡µç </span><input class="page-input" id="source-page-input" type="number" min="1" max="${Number(source.pages)||99999}" value="${modalPage}"> / ${Number(source.pages)||'?'} é¡µ</label><button class="btn btn-light btn-small" data-action="source-next">ä¸‹ä¸€é¡µ â†’</button><button class="btn btn-light btn-small" data-action="source-zoom">æ”¾å¤§ / é€‚å®½</button><a class="btn btn-soft btn-small" id="source-pdf-link" ${platform ? 'aria-disabled="true"' : `href="/api/pdf/${encodeURIComponent(source.id)}#page=${modalPage}"`} target="_blank" rel="noopener">å®Œæ•´ PDF â†—</a></div><div class="page-image-wrap" id="page-image-wrap"></div><footer class="modal-footer"><span>é¡µç æŒ‰ PDF é¡µåºè®¡ç®—ã€‚æ‰«æèµ„æ–™åŠ è½½å¯èƒ½éœ€è¦æ•°ç§’ã€‚</span><span>â† â†’ ç¿»é¡µ Â· Esc å…³é—­</span></footer></section></div>`;
    document.body.style.overflow='hidden'; updateSourcePage(); $('[data-action="source-close"]',$('#modal-root')).focus();
  }
  function updateSourcePage() {
    if(!modalSource)return;
    const imageWrap=$('#page-image-wrap'), id=modalSource.id, page=modalPage;
    imageWrap.innerHTML='<div class="page-loading">æ­£åœ¨è¯»å–åŸå§‹èµ„æ–™é¡µé¢â€¦</div>';
    $('#source-page-input').value=page;
    $('[data-action="source-prev"]').disabled=page<=1; $('[data-action="source-next"]').disabled=Number(modalSource.pages)>0&&page>=Number(modalSource.pages);
    if(platform) {
      const link=$('#source-pdf-link');link.removeAttribute('href');link.setAttribute('aria-disabled','true');
      platform.pdfUrl(id).then(url=>{if(modalSource?.id===id&&modalPage===page){link.href=`${url}#page=${page}`;link.removeAttribute('aria-disabled');}}).catch(()=>{});
      platform.renderPage(modalSource,page,imageWrap).catch(e=>{if(modalSource?.id===id&&modalPage===page)imageWrap.innerHTML=`<div class="image-error"><h3>è¿™ä¸€é¡µæš‚æ—¶æ— æ³•é¢„è§ˆ</h3><p>${esc(e.message)}</p></div>`;});
      return;
    }
    const img=document.createElement('img'); img.alt=`${modalSource.title}ï¼ŒPDF ç¬¬ ${page} é¡µ`; img.src=`/api/page/${encodeURIComponent(id)}/${page}.png`;
    img.addEventListener('load',()=>{if(modalSource?.id===id&&modalPage===page){imageWrap.replaceChildren(img);imageWrap.scrollTo(0,0);}});
    img.addEventListener('error',()=>{if(modalSource?.id===id&&modalPage===page)imageWrap.innerHTML=`<div class="image-error"><h3>è¿™ä¸€é¡µæš‚æ—¶æ— æ³•é¢„è§ˆ</h3><p>è¯·ç¡®è®¤åŸ PDF æ–‡ä»¶ä»åœ¨è½¯ä»¶èµ„æ–™ç›®å½•ä¸­ï¼Œä¹Ÿå¯ä»¥æ‰“å¼€å®Œæ•´ PDF é˜…è¯»ã€‚</p><a class="btn btn-light" href="/api/pdf/${encodeURIComponent(id)}#page=${page}" target="_blank" rel="noopener">æ‰“å¼€ PDF â†—</a></div>`;});
    $('#source-page-input').value=page; $('#source-pdf-link').href=`/api/pdf/${encodeURIComponent(id)}#page=${page}`;
    $('[data-action="source-prev"]').disabled=page<=1; $('[data-action="source-next"]').disabled=Number(modalSource.pages)>0&&page>=Number(modalSource.pages);
  }
  function closeSource() { platform?.cancelRender();$('#modal-root').replaceChildren();document.body.style.overflow='';modalSource=null;modalPreviousFocus?.focus?.(); }
  function closeSidebar() { $('#sidebar').classList.remove('open');$('#sidebar-scrim').classList.remove('open');$('#menu-toggle').setAttribute('aria-expanded','false'); }
  async function copyLocation(value) {
    const url=new URL(location.href);url.hash=value;const text=url.href;
    try { await navigator.clipboard.writeText(text);toast('ä½ç½®æ ‡è¯†å·²å¤åˆ¶ï¼Œå¯å‘é€ç»™ä½¿ç”¨åŒä¸€èµ„æ–™åŒ…çš„åŒå­¦ã€‚'); }
    catch { const input=document.createElement('textarea');input.value=text;input.style.position='fixed';input.style.opacity='0';document.body.append(input);input.select();const ok=document.execCommand('copy');input.remove();toast(ok?'ä½ç½®æ ‡è¯†å·²å¤åˆ¶ã€‚':'å¤åˆ¶æœªæˆåŠŸï¼Œå¯ä»¥æ‰‹åŠ¨å¤åˆ¶æµè§ˆå™¨åœ°å€ä¸­çš„ # åå†…å®¹ã€‚'); }
  }
  function exportProgress(prefix='ç ”ä¹ å­¦ä¹ å¤‡ä»½',notify=true) {
    progress.lastBackup=new Date().toLocaleString('zh-CN');save();
    const blob=new Blob([JSON.stringify({...progress,exportedAt:new Date().toISOString(),app:'ç ”ä¹ '},null,2)],{type:'application/json;charset=utf-8'}),url=URL.createObjectURL(blob),link=document.createElement('a');
    link.href=url;link.download=`${prefix}-${today()}.json`;document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);if(notify)toast('å¤‡ä»½å·²å¯¼å‡ºï¼Œè¯·å¦¥å–„ä¿å­˜ä¸‹è½½çš„ JSON æ–‡ä»¶ã€‚');
  }
  async function importProgress(file) {
    if(!file)return;
