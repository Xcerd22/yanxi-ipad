    return {manifest, bodyOffset};
  }

  async function verifyPdf(blob, entry) {
    if (!(blob instanceof Blob) || blob.size < 5 || blob.size > MAX_PDF || blob.size !== entry.size) throw new Error('PDF æ–‡ä»¶å¤§å°æ— æ•ˆæˆ–è¶…è¿‡ 128 MBã€‚');
    const buffer = await blob.arrayBuffer();
    if (buffer.byteLength !== entry.size) throw new Error('PDF å®é™…å†…å®¹å¤§å°ä¸ç›®å½•ä¸ä¸€è‡´ã€‚');
    if (new TextDecoder().decode(new Uint8Array(buffer, 0, 5)) !== '%PDF-') throw new Error(`â€œ${entry.path}â€ä¸æ˜¯æœ‰æ•ˆçš„ PDF æ–‡ä»¶ã€‚`);
    const hash = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', buffer)), value => value.toString(16).padStart(2, '0')).join('');
    if (hash !== entry.sha256) throw new Error(`â€œ${entry.path}â€æ ¡éªŒå¤±è´¥ã€‚è¯·é‡æ–°å¤åˆ¶å®Œæ•´èµ„æ–™åŒ…åå†è¯•ã€‚`);
    return buffer;
  }

  async function importBundle(file, onProgress = () => {}) {
    assertCapabilities();
    if (updateActionBusy) throw new Error('åº”ç”¨æ­£åœ¨æ£€æŸ¥æˆ–å¯ç”¨æ›´æ–°ï¼Œè¯·ç¨åå†å¯¼å…¥èµ„æ–™ã€‚');
    if (importBusy) throw new Error('èµ„æ–™æ­£åœ¨å¯¼å…¥ï¼Œè¯·ç­‰å¾…å½“å‰å¯¼å…¥å®Œæˆã€‚');
    if (!window.YanxiOffline?.ready) throw new Error('ç¦»çº¿åº”ç”¨å°šæœªå‡†å¤‡å¥½ï¼Œè¯·è”ç½‘é‡æ–°æ‰“å¼€å®‰è£…é¡µã€‚');
    importBusy = true;
    const id = crypto.randomUUID ? crypto.randomUUID() : `g-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    let locked = false, committed = false;
    const notify = value => { try { onProgress(value); } catch (_) { /* UI callbacks cannot interrupt a committed import. */ } };
    try {
      await window.YanxiOffline.ready;
      await claimImport(id); locked = true;
