  function importControl({initial = false} = {}) {
    const block = document.createElement('div'); block.className = 'ipad-import-control';
    // A custom extension has no registered iPadOS UTI; accept=".yanxi" can
    // disable it in Files. The header and full manifest are validated instead.
    block.innerHTML = `<input class="sr-only" type="file" aria-label="é€‰æ‹© .yanxi ç ”ä¹ ç¦»çº¿èµ„æ–™åŒ…"><button class="btn ${initial?'btn-primary':'btn-light'}" type="button">${initial?'é€‰æ‹©èµ„æ–™åŒ…ï¼Œå¼€å§‹å¯¼å…¥':'æ›´æ–°æˆ–é‡æ–°å¯¼å…¥èµ„æ–™åŒ…'}</button><div class="ipad-import-status" role="status" aria-live="polite"></div><progress class="ipad-import-progress" max="100" value="0" hidden aria-label="èµ„æ–™å¯¼å…¥è¿›åº¦"></progress>`;
    const input = block.querySelector('input'), button = block.querySelector('button'), status = block.querySelector('[role=status]'), bar = block.querySelector('progress');
    input.disabled=updateActionBusy;button.disabled=updateActionBusy;
    button.addEventListener('click', () => {
      if (updateActionBusy) { status.textContent='åº”ç”¨æ­£åœ¨æ£€æŸ¥æˆ–å¯ç”¨æ›´æ–°ï¼Œè¯·ç¨åå†å¯¼å…¥èµ„æ–™ã€‚';return; }
      input.click();
    });
    input.addEventListener('change', async () => {
      const file = input.files?.[0]; if (!file) return;
      if (updateActionBusy) { input.value='';status.textContent='åº”ç”¨æ­£åœ¨æ£€æŸ¥æˆ–å¯ç”¨æ›´æ–°ï¼Œè¯·ç¨åå†å¯¼å…¥èµ„æ–™ã€‚';return; }
      button.disabled = true; bar.hidden = false; status.classList.remove('is-error');
      const beforeUnload = event => { event.preventDefault(); event.returnValue = ''; };
      window.addEventListener('beforeunload', beforeUnload);
      try {
        await importBundle(file, item => { status.textContent = item.message; if (item.total) bar.value = Math.round(100 * item.completed / item.total); else bar.removeAttribute('value'); updateOfflineUI(); });
        status.textContent = 'å¯¼å…¥å®Œæˆï¼Œæ­£åœ¨æ‰“å¼€å¤ä¹ ä¹¦æ¡Œâ€¦';
        window.removeEventListener('beforeunload', beforeUnload);
        location.reload();
      } catch (error) { status.textContent = friendlyError(error); status.classList.add('is-error'); bar.hidden = true; }
      finally { window.removeEventListener('beforeunload', beforeUnload); button.disabled = false; input.value = ''; updateOfflineUI(); }
    });
    return block;
  }

  function mountWelcome(message = '', canImport = false) {
