      case 'mastery':{if(!topics.has(id))break;const n=Number(level);progress.topicProgress[id]={...(progress.topicProgress[id]||{}),level:n,due:afterDays([0,1,3,7][n]),reviewCount:progress.topicProgress[id]?.reviewCount||0,lastReviewed:today()};save();button.parentElement.querySelectorAll('[data-level]').forEach(b=>{b.classList.toggle('active',b.dataset.level===level);b.setAttribute('aria-pressed',b.dataset.level===level);});renderNav();toast(`å·²æ ‡è®°ä¸ºã€Œ${LEVELS[n]}ã€ã€‚`);break;}
