    if (manifest.searchPages.length > LIMITS.searchPages) throw new Error('èµ„æ–™åŒ…çš„å…¨æ–‡æ£€ç´¢é¡µæ•°è¶…è¿‡æœ¬æœºè¯»å–é™åˆ¶ã€‚');
    const indexedPages = new Set();
    for (const page of manifest.searchPages) {
