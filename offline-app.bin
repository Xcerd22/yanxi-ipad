@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
/* Reading-first question cards; math assets are bundled for offline use. */
.questions-list{display:grid;gap:24px;max-width:1100px;margin:0 auto}
.exam-card{padding:30px 34px;background:#fffefb;border:1px solid #e2e5df;border-radius:14px;box-shadow:0 3px 16px #263b2904;scroll-margin-top:102px;min-width:0}
.exam-top{align-items:flex-start;margin-bottom:20px;gap:20px}
.exam-heading-group{min-width:0}
.exam-card h2{font-family:"Segoe UI","Microsoft YaHei UI","Microsoft YaHei",sans-serif;font-size:21px;line-height:1.55;color:#25332d;margin-top:10px;letter-spacing:.01em}
.exam-metadata{gap:12px;flex-wrap:wrap;font-size:12px;color:#788078;line-height:1.7}
.exam-number{font-weight:650;color:#346759;letter-spacing:.06em}
.exam-year{padding-left:12px;border-left:1px solid #dce2d9}
.exam-metadata .tag{font-size:10px;line-height:1.6;padding:2px 7px;border-radius:4px;background:#f0f2ed;color:#75806e}
.exam-prompt{font-family:"Songti SC","SimSun","STSong",serif;font-size:18px;font-weight:400;line-height:1.95;color:#242424;background:transparent;padding:0;margin:0 0 24px;letter-spacing:0;overflow-wrap:break-word;word-break:normal}
.math-paragraph{margin:0 0 13px;min-width:0}
.math-paragraph:last-child{margin-bottom:0}
.exam-prompt .katex{font-size:1.08em;line-height:1.2;letter-spacing:0;color:#242424;text-indent:0}
.exam-prompt .katex-display{margin:14px 0 17px;padding:4px 10px;overflow-x:auto;overflow-y:hidden;text-align:center;max-width:100%}
.exam-prompt .katex-display>.katex{white-space:nowrap}
.exam-reference-row{border-top:1px solid #edf0e8;padding-top:18px}
.exam-card .knowledge-links{margin:0 0 13px;padding:0;gap:8px;background:transparent;border:0;align-items:center}
.exam-card .knowledge-links>span{font-size:11px;color:#879082;margin-right:3px}
.exam-card .knowledge-chip{background:#eff4ed;border:0;padding:5px 10px;font-size:11px;line-height:1.6;border-radius:6px;color:#537157;max-width:100%}
.exam-card .exam-bottom{padding:0 0 15px;margin:0;gap:12px;border:0;flex-wrap:wrap}
.exam-card .exam-details,.exam-card .notes-details{border:0;border-top:1px solid #edf0e8;border-radius:0;margin:0;padding:0;background:transparent}
.exam-card .exam-details summary,.exam-card .notes-details summary{font-size:12px;color:#52675b;min-height:43px;display:flex;align-items:center;gap:9px;padding:10px 0;cursor:pointer;list-style:none}
.exam-card .exam-details summary::before{content:'ï¼‹';font-size:14px;font-weight:400;color:#91a08d}
.exam-card .exam-details[open] summary::before{content:'ï¼'}
.exam-card .exam-details summary::after{display:none}
.exam-card .exam-details>ol{padding:0 0 13px 21px;font-size:14px;line-height:1.85;color:#445047}
.exam-card .exam-note{font-size:12px;line-height:1.85;padding:0 0 14px;margin:0;background:transparent;border:0;color:#707a71}
.math-fallback{font-family:Cambria,"Times New Roman",serif;white-space:pre-wrap}
@media(max-width:760px){.exam-card{padding:23px 23px;scroll-margin-top:83px}.exam-card h2{font-size:19px}.exam-prompt{font-size:18px;line-height:1.95}.questions-list{gap:18px}.exam-metadata{gap:9px}.exam-prompt .katex-display{padding:5px 2px}}
@media(max-width:480px){.exam-card{padding:21px 18px}.exam-card h2{font-size:18px}.exam-prompt{font-size:17px;line-height:1.95}.exam-metadata{font-size:11px}.exam-card .topic-actions .icon-button{width:27px}.exam-top{gap:8px}.exam-year{padding-left:8px}.exam-prompt .katex{font-size:1.06em}}

/* The same mathematical typography is used in chapters, concepts and recall. */
.math-content{display:block;font-family:"Songti SC","SimSun","STSong",serif;font-size:17px;font-weight:400;line-height:1.95;color:#242424;letter-spacing:0;overflow-wrap:break-word;word-break:normal;min-width:0}
.math-paragraph{display:block;min-width:0}
.topic-statement .math-content,.exam-prompt .math-content{font-size:18px}
.chapter-summary .math-content{font-size:16px;color:#414941}
.source-warning .math-content{font-family:inherit;font-size:12px;color:inherit}
.math-content .katex{font-size:1.08em;line-height:1.2;letter-spacing:0;color:inherit;text-indent:0}
.math-content .katex-display{margin:14px 0 17px;padding:4px 2px;overflow-x:auto;overflow-y:hidden;text-align:center;max-width:100%}
.math-content .katex-display>.katex{white-space:nowrap}
.topic-statement{overflow-wrap:break-word}
.proof-block .math-content{color:#364039}
.pitfall-block .math-content{font-size:16px;color:#685437}
.prompt-block .math-content{font-size:17px;color:#354a3b}
.pitfall-block li+li,.prompt-block li+li,.exam-details li+li{margin-top:7px}
@media(max-width:480px){.math-content{font-size:16px}.topic-statement .math-content,.exam-prompt .math-content{font-size:17px}.math-content .katex{font-size:1.06em}}

.dashboard-columns.dashboard-single{grid-template-columns:minmax(0,1fr)}
.chapter-uncovered{display:inline-block;margin-left:5px;color:#a76b35;font-size:.9em;font-weight:600;vertical-align:super;line-height:1}
.chapter-legend{grid-column:1/-1;font-size:11px;line-height:1.7;color:#8c795d;margin:0 10px 13px}
.reference-answer{padding:8px 0 19px;min-width:0}
.reference-answer .math-content{font-size:17px;line-height:2}
.reference-answer .math-paragraph{margin-bottom:18px}
.answer-references{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;border-top:1px dashed #e2e8de;padding:14px 0 18px;font-size:11px;color:#85917f}
.answer-references .text-link{font-size:11px;text-align:left}
.exam-card .answer-details summary{font-weight:600;color:var(--green)}
@media(max-width:480px){.reference-answer .math-content{font-size:16px}.chapter-legend{margin-left:0}}
