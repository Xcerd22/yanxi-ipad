    return {results:found.slice(0,80), truncated:found.length > 80, note:'æœç´¢æœ¬åœ° PDF æ–‡æœ¬å±‚ï¼›æ‰«æç‰ˆè¯·æœç´¢å·²æ•´ç†çŸ¥è¯†å¡æˆ–æµè§ˆé¡µå›¾ã€‚'};
  }

  async function readStoredPdf(generation, id, source, snapshot = true) {
