.ipad-onboarding .sidebar,.ipad-onboarding .workspace-footer,.ipad-onboarding .topbar{display:none}
.ipad-onboarding .workspace{margin-left:0}
.ipad-onboarding #main{min-height:100svh;display:grid;place-items:center;padding:38px 24px}
.ipad-welcome{max-width:780px;width:100%;padding:42px 46px;background:var(--paper);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}
.ipad-welcome .eyebrow{margin-bottom:24px}
.ipad-welcome-mark{display:grid;place-items:center;background:var(--green);color:#fffefa;border-radius:17px;width:65px;height:65px;font-size:37px;font-family:"Songti SC","STSong",serif;margin-bottom:22px}
.ipad-welcome h1{font-size:29px;line-height:1.45;max-width:590px}
.ipad-welcome-lead{font-size:15px;line-height:1.9;color:var(--muted);margin-top:15px}
.ipad-install-steps{list-style:none;padding:0;margin:32px 0 28px;display:grid;gap:23px}
.ipad-install-steps li{display:flex;gap:16px;align-items:flex-start}
.ipad-install-steps li>span{flex-shrink:0;display:grid;place-items:center;width:31px;height:31px;border-radius:50%;background:var(--green-light);color:var(--green);font-family:Georgia,serif;font-size:16px}
.ipad-install-steps strong{font-size:16px;font-weight:600}
.ipad-install-steps p{margin-top:5px;font-size:13px;line-height:1.9;color:var(--muted)}
.ipad-onboarding-state{margin:22px 0 16px;padding:14px 17px;background:#edf2e8;color:#637458;border-radius:10px;font-size:13px;line-height:1.8}
.ipad-import-control .btn{font-size:14px;min-height:44px;padding:11px 18px}
.ipad-import-status{font-size:12px;line-height:1.9;color:var(--green);margin-top:13px;overflow-wrap:anywhere}
.ipad-import-status:empty{margin:0}
.ipad-import-progress{display:block;width:100%;height:9px;margin-top:13px;border:0;border-radius:10px;overflow:hidden;accent-color:var(--green);background:#e5ecdf}
.ipad-import-progress[hidden]{display:none}
.ipad-import-progress::-webkit-progress-bar{background:#e5ecdf;border-radius:10px}
.ipad-import-progress::-webkit-progress-value{background:var(--green);border-radius:10px}
.ipad-storage-note{color:#87917e;font-size:12px;line-height:1.9;margin-top:22px}
.ipad-offline-panel{grid-column:1/-1}
.ipad-panel-heading{display:flex;align-items:center;gap:13px;justify-content:space-between}
.ipad-panel-heading h2{margin:0}
.ipad-library-stats{font-size:15px;line-height:1.7;color:var(--green);margin:18px 0 10px}
.ipad-offline-panel .ipad-offline-ready{font-size:12px;color:var(--green);margin:0 0 9px}
.ipad-storage-details{font-size:11px;color:var(--muted);margin-bottom:18px}
.ipad-offline-panel .ipad-storage-note{margin:18px 0 0}
.ipad-offline-panel>p{font-size:12px}
.ipad-update-banner{margin:18px 34px 0;padding:14px 18px;border:1px solid var(--line);border-radius:12px;background:var(--green-light);display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:14px;line-height:1.7}
.ipad-update-banner .btn{flex-shrink:0}.ipad-update-banner .btn[hidden]{display:none}
.ipad-app-update{grid-column:1/-1}
.ipad-app-update .ipad-update-status{font-size:13px;line-height:1.8;color:var(--green);margin:16px 0}
.ipad-update-actions{display:flex;flex-wrap:wrap;gap:12px}
.ipad-update-actions .btn{min-height:44px}.ipad-update-actions .btn[hidden]{display:none}
@media(max-width:600px){.ipad-update-banner{margin:12px 14px 0;align-items:flex-start;flex-direction:column}}
.is-error{color:#a54432!important}
.page-image-wrap .ipad-pdf-canvas{display:block;max-width:100%;height:auto;margin:0 auto;box-shadow:0 3px 18px #2945221a;background:#fff}
.page-image-wrap.zoomed .ipad-pdf-canvas{max-width:none;width:1400px}
.page-image-wrap .image-error p{margin:10px 0 18px;font-size:13px;line-height:1.9}
@media(max-width:1100px){.sidebar{transform:translateX(-100%);transition:transform .2s;width:248px;z-index:50}.sidebar.open{transform:translateX(0)}.sidebar-scrim.open{display:block;position:fixed;inset:0;z-index:40;background:#21382670}.workspace{margin-left:0}.menu-button{display:grid}.topbar{padding:0 22px;gap:16px}.global-search{max-width:440px}.chapter-index{max-height:280px}.modal-toolbar .btn{min-height:42px}.page-input{min-height:42px;font-size:16px}}
@media(pointer:coarse){.icon-button{min-width:42px;min-height:42px}.filter-chip{min-height:42px}.mastery-button{min-height:40px}.modal-toolbar .btn{min-height:40px}.chapter-link{min-height:44px}.page-input{font-size:16px;min-height:40px}.global-search input{font-size:16px}.source-modal{height:94svh}.modal-backdrop{padding-top:max(8px,env(safe-area-inset-top));padding-bottom:max(8px,env(safe-area-inset-bottom))}}
@media(max-width:600px){.ipad-onboarding #main{padding:18px 14px}.ipad-welcome{padding:27px 23px;border-radius:17px}.ipad-welcome h1{font-size:25px}.ipad-welcome-lead{font-size:14px}.ipad-install-steps{gap:20px;margin-top:27px}.ipad-install-steps li{gap:12px}.ipad-welcome .eyebrow{font-size:9px}.ipad-import-control .btn{width:100%}.ipad-panel-heading{align-items:flex-start}.ipad-panel-heading .tag{white-space:nowrap}.ipad-library-stats{font-size:14px}}
